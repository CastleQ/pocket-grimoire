\uc788\uc2b5\ub2c8\ub2e4."},{"id":"hatter","reason":"\uad70\ub2e8\uc774 \ub9cc\ub4e4\uc5b4\uc9c0\uba74, \ubaa8\ub4e0 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4. \uad70\ub2e8\uc774 \ucc38\uc5ec\ud55c\ub2e4\uba74, \ubaa8\uc790 \uc7a5\uc218\ub294 \ub2a5\ub825\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"zealot","reason":"\uad11\uc2e0\uc790\ub294 \uad70\ub2e8\uc5d0\uac8c \uc545\ud55c \ud300\uc73c\ub85c \uc778\uc2dd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc815\uce58\uc778\uc740 \uad70\ub2e8\uc5d0\uac8c \uc545\ud55c \ud300\uc73c\ub85c \uc778\uc2dd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"scarletwoman","jinx":[{"id":"fanggu","reason":"\uc545\ub9c8\uac00 2\uba85\uc774 \ub418\ub294\ub370 \uadf8\uc911 1\uba85\uc774 \ud0d5\ub140\uc600\ub2e4\uba74, \ud0d5\ub140\ub294 \ud0d5\ub140\ub85c \ub0a8\uc2b5\ub2c8\ub2e4."},{"id":"alhadikhia","reason":"\uc545\ub9c8\uac00 2\uba85\uc774 \ub418\ub294\ub370 \uadf8\uc911 1\uba85\uc774 \ud0d5\ub140\uc600\ub2e4\uba74, \ud0d5\ub140\ub294 \ub2e4\uc2dc \ud0d5\ub140\uac00 \ub429\ub2c8\ub2e4."}]},{"id":"spy","jinx":[{"id":"poppygrower","reason":"\uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\ub2e4\uba74, \ucca9\uc790\ub294 \ub9c8\ub3c4\uc11c\ub97c \ubcf4\uc9c0 \ubabb\ud569\ub2c8\ub2e4."},{"id":"damsel","reason":"\ucca9\uc790\uac00 \ucc38\uc5ec\ud558\uace0 \uc788\ub2e4\uba74(\ub610\ub294 \ucc38\uc5ec\ud55c \uc801\uc774 \uc788\ub2e4\uba74), \uc544\uac00\uc528\ub294 \uc911\ub3c5\ub429\ub2c8\ub2e4."},{"id":"ogre","reason":"\ucca9\uc790\ub294 \uc624\uc6b0\uac70\uc5d0\uac8c \uc545\ud55c \ud300\uc73c\ub85c \uc778\uc2dd\ub429\ub2c8\ub2e4."}]},{"id":"widow","jinx":[{"id":"poppygrower","reason":"\uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\ub2e4\uba74, \ubbf8\ub9dd\uc778\uc740 \ub9c8\ub3c4\uc11c\ub97c \ubcf4\uc9c0 \ubabb\ud569\ub2c8\ub2e4."},{"id":"damsel","reason":"\ubbf8\ub9dd\uc778\uc774 \ucc38\uc5ec\ud558\uace0 \uc788\ub2e4\uba74(\ub610\ub294 \ucc38\uc5ec\ud55c \uc801\uc774 \uc788\ub2e4\uba74), \uc544\uac00\uc528\ub294 \uc911\ub3c5\ub429\ub2c8\ub2e4."}]},{"id":"yaggababble","jinx":[{"id":"exorcist","reason":"\uad6c\ub9c8\uc0ac\uc81c\uac00 \uc57c\uac00\ubc14\ube14\uc744 \uc120\ud0dd\ud558\uba74, \uc57c\uac00\ubc14\ube14\uc740 \uc624\ub298 \ubc24 \uc8fd\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"summoner","jinx":[{"id":"clockmaker","reason":"\uc18c\ud658\uc0ac\ub294 \uc2dc\uacc4\uacf5\uc5d0\uac8c \uc545\ub9c8\ub85c \uc778\uc2dd\ub429\ub2c8\ub2e4."},{"id":"poppygrower","reason":"\uc14b\uc9f8 \ub0a0 \ubc24\uc5d0 \uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \uc0b4\uc544 \uc788\ub2e4\uba74, \uc18c\ud658\uc0ac\ub294 \uc5b4\ub5a4 \uc545\ub9c8\uc778\uc9c0\ub9cc \uc120\ud0dd\ud558\uace0 \uc5b4\ub5a4 \ud50c\ub808\uc774\uc5b4\uc778\uc9c0\ub294 \uc120\ud0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"marionette","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uc5ec\ud558\uac8c \ub41c\ub2e4\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8\ubcf4\ub2e4 \ub098\uc911\uc5d0 \ucc38\uc5ec\ud558\uba70, \ubc18\ub4dc\uc2dc \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"pithag","reason":"\uc18c\ud658\uc0ac\uac00 \uc0b4\uc544 \uc788\ub294 \ub450 \ubc88\uc9f8 \uc545\ub9c8\ub97c \ub9cc\ub4e4\uc5b4 \ub0b4\uba74, \uc624\ub298 \ubc24\uc5d0\ub294 \uc608\uce21\ubd88\ud5c8\uc758 \uc8fd\uc74c\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."},{"id":"hatter","reason":"\uc18c\ud658\uc0ac\uac00 \uc0b4\uc544 \uc788\ub294 \ub450 \ubc88\uc9f8 \uc545\ub9c8\ub97c \ub9cc\ub4e4\uc5b4 \ub0b4\uba74, \uc624\ub298 \ubc24\uc5d0\ub294 \uc608\uce21\ubd88\ud5c8\uc758 \uc8fd\uc74c\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."},{"id":"courtier","reason":"\uc0b4\uc544 \uc788\ub294 \uc18c\ud658\uc0ac\uc5d0\uac8c \ub2a5\ub825\uc774 \uc5c6\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uac16\uc2b5\ub2c8\ub2e4."},{"id":"engineer","reason":"\uc0b4\uc544 \uc788\ub294 \uc18c\ud658\uc0ac\uac00 \uac8c\uc784\uc5d0\uc11c \ube60\uc9c0\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uac16\uc2b5\ub2c8\ub2e4."},{"id":"zombuul","reason":"\uc18c\ud658\uc0ac\uac00 \uc8fd\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc880\ubc84\uc5bc\ub85c \uc18c\ud658\ud558\uba74, \uadf8 \uc880\ubc84\uc5bc\uc740 \uc774\ubbf8 \u0022\ud55c \ubc88 \uc8fd\uc740\u0022 \uac83\uc73c\ub85c \uce69\ub2c8\ub2e4."},{"id":"pukka","reason":"\uc18c\ud658\uc0ac\ub294 \uc14b\uc9f8 \ub0a0 \ubc24 \ub300\uc2e0 \ub458\uc9f8 \ub0a0 \ubc24\uc5d0 \ud478\uce74\ub97c \uc18c\ud658\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"legion","reason":"\uad70\ub2e8\uc774 \uc18c\ud658\ub418\uba74, \ubaa8\ub4e0 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4."},{"id":"kazali","reason":"\uc18c\ud658\uc0ac\uac00 \uc0b4\uc544 \uc788\ub294 \ub450 \ubc88\uc9f8 \uc545\ub9c8\ub97c \ub9cc\ub4e4\uc5b4 \ub0b4\uba74, \uc624\ub298 \ubc24\uc5d0\ub294 \uc608\uce21\ubd88\ud5c8\uc758 \uc8fd\uc74c\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc0b4\uc544 \uc788\ub294 \uc18c\ud658\uc0ac\uc5d0\uac8c \ub2a5\ub825\uc774 \uc5c6\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uac16\uc2b5\ub2c8\ub2e4."},{"id":"lordoftyphon","reason":"\ud2f0\ud3f0\uc758 \uad70\uc8fc\uac00 \uc18c\ud658\ub418\uba74, \ud2f0\ud3f0\uc758 \uad70\uc8fc\ub294 \ubc18\ub4dc\uc2dc \ud558\uc218\uc778\uacfc \uc774\uc6c3\ud574\uc57c \ud558\uba70, \ub2e4\ub978 \ucabd \uc774\uc6c3\uc740 \uc545\ud55c \ud558\uc218\uc778\uc774 \ub429\ub2c8\ub2e4."}]},{"id":"marionette","jinx":[{"id":"lilmonsta","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uc5ec\ud558\uac8c \ub41c\ub2e4\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8\ubcf4\ub2e4 \ub098\uc911\uc5d0 \ucc38\uc5ec\ud558\uba70, \ubc18\ub4dc\uc2dc \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"balloonist","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \uc790\uc2e0\uc744 \uc5f4\uae30\uad6c \uc870\uc885\uc0ac\ub77c\uace0 \uc0dd\uac01\ud55c\ub2e4\uba74, \uac8c\uc784\uc744 \uc900\ube44\ud560 \ub54c \uc678\uc9c0\uc778\uc774 \ucd94\uac00\ub418\uc5c8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"huntsman","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \uc790\uc2e0\uc744 \uc0ac\ub0e5\uafbc\uc774\ub77c\uace0 \uc0dd\uac01\ud55c\ub2e4\uba74, \uac8c\uc784\uc744 \uc900\ube44\ud560 \ub54c \uc544\uac00\uc528\uac00 \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}]},{"id":"lleech","jinx":[{"id":"mastermind","reason":"\uc8fc\ubaa8\uc790\uac00 \uc0b4\uc544 \uc788\ub294\ub370 \uac70\ubb34\ub9ac\uc758 \uc219\uc8fc\uac00 \ucc98\ud615\uc73c\ub85c \uc8fd\uc73c\uba74, \uac70\ubb34\ub9ac\ub294 \uc0b4\uc544\ub0a8\uc9c0\ub9cc \ub2a5\ub825\uc744 \uc783\uc2b5\ub2c8\ub2e4."},{"id":"slayer","reason":"\ucc98\ub2e8\uc790\uac00 \uac70\ubb34\ub9ac\uc758 \uc219\uc8fc\ub97c \uc3d8\uba74, \uc219\uc8fc\ub294 \uc8fd\uc2b5\ub2c8\ub2e4."}]},{"id":"kazali","jinx":[{"id":"marionette","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uc5ec\ud558\uac8c \ub41c\ub2e4\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8\ubcf4\ub2e4 \ub098\uc911\uc5d0 \ucc38\uc5ec\ud558\uba70, \ubc18\ub4dc\uc2dc \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."}]},{"id":"riot","jinx":[{"id":"mayor","reason":"\uc2dc\uc7a5\uc740 \ud3ed\ub3d9\uc744 \uba48\ucd94\uae30\ub85c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud3ed\ub3c4\uac00 1\uba85\ub9cc \uc0b4\uc544 \uc788\uc744 \ub54c \uadf8\ub807\uac8c \ud558\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74, \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"monk","reason":"\ud3ed\ub3c4\uac00 \uc218\ub3c4\uc0ac\uc5d0\uac8c \ubcf4\ud638\ubc1b\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \uc9c0\ubaa9\ud574 \ucc98\ud615\ud558\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"farmer","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 \uc0b4\uc544 \uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4 1\uba85(\uc774\uc804 \ubc24\uacfc \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4: \uc120\ud0dd\ub41c \ub18d\ubd80\ub294 \ub2a5\ub825\uc744 \uc4f0\uc9c0\ub9cc \uc8fd\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"innkeeper","reason":"\ud3ed\ub3c4\uac00 \uc5ec\uad00 \uc8fc\uc778\uc5d0\uac8c \ubcf4\ud638\ubc1b\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \uc9c0\ubaa9\ud574 \ucc98\ud615\ud558\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"sage","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 \uc0b4\uc544 \uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4 1\uba85(\uc774\uc804 \ubc24\uacfc \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4: \uc120\ud0dd\ub41c \ud604\uc790\ub294 \ub2a5\ub825\uc744 \uc4f0\uc9c0\ub9cc \uc8fd\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"banshee","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 \uc0b4\uc544 \uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4 1\uba85(\uc774\uc804 \ubc24\uacfc \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4: \uc120\ud0dd\ub41c \ubc34\uc2dc\ub294 \uc8fd\uace0 \ub2a5\ub825\uc744 \uc5bb\uc2b5\ub2c8\ub2e4."},{"id":"ravenkeeper","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 \uc0b4\uc544 \uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4 1\uba85(\uc774\uc804 \ubc24\uacfc \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4: \uc120\ud0dd\ub41c \uae4c\ub9c8\uadc0\uc9c0\uae30\ub294 \ub2a5\ub825\uc744 \uc4f0\uc9c0\ub9cc \uc8fd\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"soldier","reason":"\ud3ed\ub3c4\uac00 \uad70\uc778\uc744 \uc9c0\ubaa9\ud574 \ucc98\ud615\ud558\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"grandmother","reason":"\ud3ed\ub3c4\uac00 \ucc38\uc5ec\ud558\ub294\ub370 \uc190\uc8fc\uac00 \ucc98\ud615\uc73c\ub85c \uc8fd\uc73c\uba74, \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"king","reason":"\ud3ed\ub3c4\uac00 \ucc38\uc5ec\ud558\uace0 \uc801\uc5b4\ub3c4 1\uba85\uc774 \uc8fd\uc5c8\ub2e4\uba74, \uc655\uc740 \ub9e4\uc77c \ubc24 \uc0b4\uc544 \uc788\ub294 \uce90\ub9ad\ud130 1\uac1c\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"exorcist","reason":"\ud3ed\ub3c4\uac00 \uad6c\ub9c8\uc0ac\uc81c\uac00 \uc120\ud0dd\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc9c0\ubaa9\ud574 \ucc98\ud615\ud558\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"atheist","reason":"\ud3ed\ub3d9 \uc911\uc5d0 \uc774\uc57c\uae30\uafbc\uc774 \uc9c0\ubaa9\ub418\uba74, \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \ud22c\ud45c\ud569\ub2c8\ub2e4. \uc774\uc57c\uae30\uafbc\uc774 \u0022\uc0ac\ub9dd \uc608\uc815\u0022\uc774 \ub418\uba74 \uac8c\uc784\uc774 \ub05d\ub0a9\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74, \uc774\uc57c\uae30\uafbc\uc774 \ub2e4\uc2dc \uc9c0\ubaa9\ud569\ub2c8\ub2e4."}]},{"id":"butler","jinx":[{"id":"organgrinder","reason":"\uac70\ub9ac\uc758 \uc545\uc0ac \ub54c\ubb38\uc5d0 \ub208\uc744 \uac10\uace0 \ud22c\ud45c\ud560 \ub54c, \uc9d1\uc0ac\ub294 \uc190\uc744 \ub4e4\uc5b4 \ud22c\ud45c\ud560 \uc218 \uc788\uc9c0\ub9cc, \uadf8 \ud45c\ub294 \uc8fc\uc778\ub3c4 \ud22c\ud45c\ud588\uc744 \ub54c\ub9cc \uc778\uc815\ub429\ub2c8\ub2e4."}]},{"id":"vizier","jinx":[{"id":"investigator","reason":"\uc774\uc57c\uae30\uafbc\uc740 \uc7ac\uc0c1\uc774 \ucc38\uc5ec\ud55c\ub2e4\uace0 \uc120\uc5b8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc7ac\uc0c1\uc774 \ub2a5\ub825\uc744 \uc783\uc73c\uba74, \uc7ac\uc0c1\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub418\uba70, \ub0ae \ub3d9\uc548 \uc8fd\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"courtier","reason":"\uc7ac\uc0c1\uc774 \ub2a5\ub825\uc744 \uc783\uc73c\uba74, \uc7ac\uc0c1\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub418\uba70, \ub0ae \ub3d9\uc548 \uc8fd\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"fearmonger","reason":"\uc7ac\uc0c1\uc740 \uacf5\ud3ec\uc758 \uc804\ub839\uacfc \ud568\uaed8 \uae68\uc5b4\ub098 \uacf5\ud3ec\uc758 \uc804\ub839\uc774 \ub204\uad6c\ub97c \uc120\ud0dd\ud558\ub294\uc9c0 \uc54c\uac8c \ub418\uba70, \uadf8 \ud50c\ub808\uc774\uc5b4\ub97c \uc989\uc2dc \ucc98\ud615\ud558\uae30\ub85c \uc120\ud0dd\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc815\uce58\uc778\uc740 \uc7ac\uc0c1\uc5d0\uac8c \uc545\ud55c \ud300\uc73c\ub85c \uc778\uc2dd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"alsaahir","reason":"\uc774\uc57c\uae30\uafbc\uc740 \uc7ac\uc0c1\uc774 \ucc38\uc5ec\ud55c\ub2e4\uace0 \uc120\uc5b8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"zealot","reason":"\uad11\uc2e0\uc790\ub294 \uc7ac\uc0c1\uc5d0\uac8c \uc545\ud55c \ud300\uc73c\ub85c \uc778\uc2dd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"vortox","jinx":[{"id":"banshee","reason":"\ubcf4\ub974\ud1a1\uc2a4\uac00 \ubc34\uc2dc\ub97c \uc8fd\uc774\uba74, \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\ub294 \ubc34\uc2dc\uac00 \uc8fd\uc5c8\ub2e4\ub294 \uac83\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"ogre","jinx":[{"id":"recluse","reason":"\uc740\ub454\uc790\uac00 \uc624\uc6b0\uac70\uc5d0\uac8c \uc545\ud55c \ud300\uc73c\ub85c \uc778\uc2dd\ub418\uba74, \uc624\uc6b0\uac70\ub294 \uc790\uc2e0\uc774 \uc545\ud55c \ud300\uc774\ub77c\ub294 \uac83\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"mastermind","jinx":[{"id":"alhadikhia","reason":"\uc54c \ud558\ub514\ud0a4\uc544\uac00 \ucc98\ud615\uc73c\ub85c \uc8fd\uc5c8\uace0 \uc8fc\ubaa8\uc790\uac00 \uc0b4\uc544 \uc788\ub2e4\uba74, \uc54c \ud558\ub514\ud0a4\uc544\ub294 \uc624\ub298 \ubc24 \uc120\ud55c \ud50c\ub808\uc774\uc5b4 3\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4: 3\uba85\uc774 \ubaa8\ub450 \uc0b4\uae30\ub85c \uc120\ud0dd\ud558\uba74 \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"vigormortis","reason":"\ub2a5\ub825\uc744 \uac00\uc9c4 \uc8fc\ubaa8\uc790\ub294 \ube44\uace0\ub974\ubaa8\ub974\ud2f0\uc2a4\uac00 \uc8fd\uc5b4\ub3c4 \ub2a5\ub825\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."}]},{"id":"boffin","jinx":[{"id":"cultleader","reason":"\uc545\ub9c8\uac00 \uc0ac\uad50 \uad50\uc8fc\uc758 \ub2a5\ub825\uc744 \uac00\uc84c\ub2e4\uba74, \uc545\ub9c8\ub294 \uc774 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"goon","reason":"\uc545\ub9c8\uac00 \uac74\ub2ec\uc758 \ub2a5\ub825\uc744 \uac00\uc84c\ub2e4\uba74, \uc545\ub9c8\ub294 \uc774 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"ogre","reason":"\uc545\ub9c8\ub294 \uc624\uc6b0\uac70\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc545\ub9c8\ub294 \uc815\uce58\uc778\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"drunk","reason":"\uc545\ub9c8\ub294 \uc8fc\uc815\ubc45\uc774\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"villageidiot","reason":"\ub0a8\ub294 \ud1a0\ud070\uc774 \uc788\ub2e4\uba74, \uacfc\ud559\uc790\ub294 \uc545\ub9c8\uc5d0\uac8c \ub9c8\uc744 \ubc31\uce58\uc758 \ub2a5\ub825\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"plaguedoctor","jinx":[{"id":"eviltwin","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uc0ac\uc545\ud55c \uc30d\ub465\uc774\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud50c\ub808\uc774\uc5b4 1\uba85\uc774 \uc0ac\uc545\ud55c \uc30d\ub465\uc774\uac00 \ub429\ub2c8\ub2e4."},{"id":"fearmonger","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uacf5\ud3ec\uc758 \uc804\ub839\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"goblin","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uace0\ube14\ub9b0\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"spy","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ucca9\uc790\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"scarletwoman","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ud0d5\ub140\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"boomdandy","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ud3ed\ud0c4\ub9c8\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud50c\ub808\uc774\uc5b4 1\uba85\uc774 \ud3ed\ud0c4\ub9c8\uac00 \ub429\ub2c8\ub2e4."},{"id":"baron","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ub0a8\uc791\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ucd5c\ub300 2\uba85\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uc678\uc9c0\uc778\uc774 \ub429\ub2c8\ub2e4."},{"id":"marionette","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uaf2d\ub450\uac01\uc2dc\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \uc545\ub9c8\uc758 \uc120\ud55c \uc774\uc6c3 \uc911 1\uba85\uc774 \uaf2d\ub450\uac01\uc2dc\uac00 \ub429\ub2c8\ub2e4."},{"id":"wraith","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uc545\ub839\uc758 \ub2a5\ub825\uc744 \uc5bb\uac8c \ub418\uba74, \ub300\uc2e0 \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"heretic","jinx":[{"id":"godfather","reason":"\uc9d5\ud06c\uc2a4\uac00 \uc788\ub294 \ub450 \uce90\ub9ad\ud130 \uc911 1\uac1c\ub9cc \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"baron","reason":"\uc9d5\ud06c\uc2a4\uac00 \uc788\ub294 \ub450 \uce90\ub9ad\ud130 \uc911 1\uac1c\ub9cc \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"pithag","reason":"\uc9d5\ud06c\uc2a4\uac00 \uc788\ub294 \ub450 \uce90\ub9ad\ud130 \uc911 1\uac1c\ub9cc \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"spy","reason":"\uc9d5\ud06c\uc2a4\uac00 \uc788\ub294 \ub450 \uce90\ub9ad\ud130 \uc911 1\uac1c\ub9cc \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"widow","reason":"\uc9d5\ud06c\uc2a4\uac00 \uc788\ub294 \ub450 \uce90\ub9ad\ud130 \uc911 1\uac1c\ub9cc \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"lleech","reason":"\uc9d5\ud06c\uc2a4\uac00 \uc788\ub294 \ub450 \uce90\ub9ad\ud130 \uc911 1\uac1c\ub9cc \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"boffin","reason":"\uc545\ub9c8\ub294 \ubc30\uad50\uc790\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"bountyhunter","jinx":[{"id":"philosopher","reason":"\ucca0\ud559\uc790\uac00 \ud604\uc0c1\uae08 \uc0ac\ub0e5\uafbc\uc758 \ub2a5\ub825\uc744 \uc5bb\uc73c\uba74, \uc8fc\ubbfc 1\uba85\uc774 \uc545\ud55c \ud300\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"kazali","reason":"\uce74\uc798\ub9ac\uac00 \ud604\uc0c1\uae08 \uc0ac\ub0e5\uafbc\uc744 \ud558\uc218\uc778\uc73c\ub85c \ubc14\uafb8\uba74, \uc545\ud55c \uc8fc\ubbfc\uc740 \ub9cc\ub4e4\uc5b4\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"alhadikhia","jinx":[{"id":"princess","reason":"\uacf5\uc8fc\uac00 \uc790\uc2e0\uc758 \uccab \ubc88\uc9f8 \ub0ae\uc5d0 \ud50c\ub808\uc774\uc5b4\ub97c \uc9c0\ubaa9\ud574 \ucc98\ud615\ud588\ub2e4\uba74, \uc624\ub298 \ubc24 \uc54c \ud558\ub514\ud0a4\uc544 \ub54c\ubb38\uc5d0 \uc8fd\ub294 \uc0ac\ub78c\uc740 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"alchemist","jinx":[{"id":"wraith","reason":"\uc5f0\uae08\uc220\uc0ac-\uc545\ub839\uc740 \uc545\ub839\uc758 \ub2a5\ub825\uc774 \uc5c6\uc73c\uba70, \uc545\ub839\uc774 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \ub9e4\ubc88 \ucc98\ud615\uc774 \ub05d\ub09c \ub4a4, \uc0b4\uc544 \uc788\ub294 \uc5f0\uae08\uc220\uc0ac-\uc545\ub839\uc740 \uc0b4\uc544 \uc788\ub294 \ud50c\ub808\uc774\uc5b4 1\uba85\uc744 \uc545\ub839\uc73c\ub85c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \uc545\ub839\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"spy","reason":"\uc5f0\uae08\uc220\uc0ac-\ucca9\uc790\ub294 \ucca9\uc790\uc758 \ub2a5\ub825\uc774 \uc5c6\uc73c\uba70, \ucca9\uc790\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \ub9e4\ubc88 \ucc98\ud615\uc774 \ub05d\ub09c \ub4a4, \uc0b4\uc544 \uc788\ub294 \uc5f0\uae08\uc220\uc0ac-\ucca9\uc790\ub294 \uc0b4\uc544 \uc788\ub294 \ud50c\ub808\uc774\uc5b4 1\uba85\uc744 \ucca9\uc790\ub85c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \ucca9\uc790\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"widow","reason":"\uc5f0\uae08\uc220\uc0ac-\ubbf8\ub9dd\uc778\uc740 \ubbf8\ub9dd\uc778\uc758 \ub2a5\ub825\uc774 \uc5c6\uc73c\uba70, \ubbf8\ub9dd\uc778\uc774 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \ub9e4\ubc88 \ucc98\ud615\uc774 \ub05d\ub09c \ub4a4, \uc0b4\uc544 \uc788\ub294 \uc5f0\uae08\uc220\uc0ac-\ubbf8\ub9dd\uc778\uc740 \uc0b4\uc544 \uc788\ub294 \ud50c\ub808\uc774\uc5b4 1\uba85\uc744 \ubbf8\ub9dd\uc778\uc73c\ub85c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \ubbf8\ub9dd\uc778\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"marionette","reason":"\uc5f0\uae08\uc220\uc0ac-\uaf2d\ub450\uac01\uc2dc\ub294 \uaf2d\ub450\uac01\uc2dc\uc758 \ub2a5\ub825\uc774 \uc5c6\uc73c\uba70, \uaf2d\ub450\uac01\uc2dc\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4."},{"id":"summoner","reason":"\uc5f0\uae08\uc220\uc0ac-\uc18c\ud658\uc0ac\ub294 \ube14\ub7ec\ud551\uc6a9 \uce90\ub9ad\ud130\ub97c \ubc1b\uc9c0 \uc54a\uc73c\uba70, \uc5b4\ub5a4 \uc545\ub9c8\uc778\uc9c0\ub9cc \uc120\ud0dd\ud558\uace0 \uc5b4\ub5a4 \ud50c\ub808\uc774\uc5b4\uc778\uc9c0\ub294 \uc120\ud0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uadf8 \uc804\uc5d0 \uc5f0\uae08\uc220\uc0ac-\uc18c\ud658\uc0ac\uac00 \uc8fd\uc73c\uba74, \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4. [\uc545\ub9c8 \uc5c6\uc74c]"},{"id":"mastermind","reason":"\uc5f0\uae08\uc220\uc0ac-\uc8fc\ubaa8\uc790\ub294 \uc8fc\ubaa8\uc790\uc758 \ub2a5\ub825\uc774 \uc5c6\uc73c\uba70, \uc8fc\ubaa8\uc790\ub294 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"organgrinder","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uac70\ub9ac\uc758 \uc545\uc0ac\uc758 \ub2a5\ub825\uc744 \uac00\uc84c\ub2e4\uba74, \uac70\ub9ac\uc758 \uc545\uc0ac\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \ub458 \ub2e4 \ub9e8\uc815\uc2e0\uc774\ub77c\uba74, \ub458 \ub2e4 \ucde8\ud569\ub2c8\ub2e4."},{"id":"boffin","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uacfc\ud559\uc790\uc758 \ub2a5\ub825\uc744 \uac00\uc84c\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \uc545\ub9c8\uac00 \uc5b4\ub5a4 \ub2a5\ub825\uc744 \uac00\uc84c\ub294\uc9c0 \uc54c\uac8c \ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"magician","jinx":[{"id":"widow","reason":"\ubbf8\ub9dd\uc778\uc774 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \ub54c, \uc545\ub9c8\uc640 \ub9c8\uc220\uc0ac\uc758 \uce90\ub9ad\ud130 \ud1a0\ud070\uc740 \uce58\uc6cc \ub461\ub2c8\ub2e4."},{"id":"spy","reason":"\ucca9\uc790\uac00 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \ub54c, \uc545\ub9c8\uc640 \ub9c8\uc220\uc0ac\uc758 \uce90\ub9ad\ud130 \ud1a0\ud070\uc740 \uce58\uc6cc \ub461\ub2c8\ub2e4."},{"id":"wraith","reason":"\ub9e4\ubc88 \ucc98\ud615\uc774 \ub05d\ub09c \ub4a4, \uc0b4\uc544 \uc788\ub294 \ub9c8\uc220\uc0ac\ub294 \uc0b4\uc544 \uc788\ub294 \ud50c\ub808\uc774\uc5b4 1\uba85\uc744 \uc545\ub839\uc73c\ub85c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce2