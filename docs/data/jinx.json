[{"id":"mathematician","jinx":[{"id":"chambermaid","reason":"\uac1d\uc2e4 \uccad\uc18c\ubd80\ub294 \uc218\ud559\uc790\uac00 \uc624\ub298 \ubc24 \uae68\uc5b4\ub0a0\uc9c0 \uc54c\uc544\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"lunatic","reason":"\uc218\ud559\uc790\ub294 \ubbf8\uce58\uad11\uc774\uac00 \uc2e4\uc81c \uc545\ub9c8\uac00 \uacf5\uaca9\ud55c \ud50c\ub808\uc774\uc5b4\uc640 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \uacf5\uaca9\ud588\ub294\uc9c0 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"drunk","reason":"\uc218\ud559\uc790\ub294 \uc8fc\uc815\ubc45\uc774\uc758 \ub2a5\ub825\uc774 \uac70\uc9d3 \uc815\ubcf4\ub97c \uc8fc\uc5c8\uac70\ub098 \uc81c\ub300\ub85c \uc791\ub3d9\ud558\uc9c0 \uc54a\uc558\ub294\uc9c0\ub3c4 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"marionette","reason":"\uc218\ud559\uc790\ub294 \uaf2d\ub450\uac01\uc2dc\uc758 \ub2a5\ub825\uc774 \uac70\uc9d3 \uc815\ubcf4\ub97c \uc8fc\uc5c8\uac70\ub098 \uc81c\ub300\ub85c \uc791\ub3d9\ud558\uc9c0 \uc54a\uc558\ub294\uc9c0\ub3c4 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"cannibal","jinx":[{"id":"butler","reason":"\uc2dd\uc778\uc885\uc774 \uc9d1\uc0ac\uc758 \ub2a5\ub825\uc744 \uc5bb\uc73c\uba74, \uc2dd\uc778\uc885\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"juggler","reason":"\uace1\uc608\uc0ac\uac00 \uc790\uc2e0\uc758 \uccab\uc9f8 \ub0a0\uc5d0 \ucd94\uce21\ud588\uace0 \ucc98\ud615\uc73c\ub85c \uc8fd\uc73c\uba74, \uc624\ub298 \ubc24 \uc0b4\uc544 \uc788\ub294 \uc2dd\uc778\uc885\uc740 \uace1\uc608\uc0ac\uac00 \uba87 \uac1c\ub97c \ub9de\ud614\ub294\uc9c0 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"zealot","reason":"\uc2dd\uc778\uc885\uc774 \uad11\uc2e0\uc790\uc758 \ub2a5\ub825\uc744 \uc5bb\uc73c\uba74, \uc2dd\uc778\uc885\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"princess","reason":"\uc2dd\uc778\uc885\uc774 \uc624\ub298 \uacf5\uc8fc\ub97c \uc9c0\ubaa9\ud574 \ucc98\ud615\ud574\uc11c \uc8fd\uc600\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \uc8fd\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"pithag","jinx":[{"id":"damsel","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc544\uac00\uc528\ub97c \ub9cc\ub4e4\uc5b4 \ub0b4\uba74, \uc5b4\ub5a4 \ud50c\ub808\uc774\uc5b4\uac00 \uc544\uac00\uc528\uac00 \ub420\uc9c0\ub294 \uc774\uc57c\uae30\uafbc\uc774 \uc815\ud569\ub2c8\ub2e4."},{"id":"politician","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc815\uce58\uc778\uc73c\ub85c \ubc14\uafb8\uba74, \uadf8 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"villageidiot","reason":"\ub0a8\ub294 \ud1a0\ud070\uc774 \uc788\ub2e4\uba74, \ub9c8\uadc0\ud560\uba48\uc740 \ub9c8\uc744 \ubc31\uce58\ub97c 1\uba85 \ub354 \ub9cc\ub4e4\uc5b4 \ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub807\uac8c \ub418\uba74, \ucde8\ud55c \ub9c8\uc744 \ubc31\uce58\uac00 \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"cultleader","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc0ac\uad50 \uad50\uc8fc\ub85c \ubc14\uafb8\uba74, \uadf8 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"goon","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uac74\ub2ec\ub85c \ubc14\uafb8\uba74, \uadf8 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"ogre","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc624\uc6b0\uac70\ub85c \ubc14\uafb8\uba74, \uadf8 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"cerenovus","jinx":[{"id":"goblin","reason":"\uc138\ub808\ub178\ubc84\uc2a4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc774 