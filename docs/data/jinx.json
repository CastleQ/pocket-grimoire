[{"id":"mathematician","jinx":[{"id":"chambermaid","reason":"\uac1d\uc2e4 \uccad\uc18c\ubd80\ub294 \uc218\ud559\uc790\uac00 \uc624\ub298 \ubc24 \uae68\uc5b4\ub098\ub294\uc9c0 \uc5ec\ubd80\ub97c \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"lunatic","reason":"\uc218\ud559\uc790\ub294 \ubbf8\uce58\uad11\uc774\uac00 \uc120\ud0dd\ud55c \ucc38\uac00\uc790\uac00 \uc545\ub9c8\uac00 \uacf5\uaca9\ud55c \ucc38\uac00\uc790\uc640 \ub2e4\ub97c \uacbd\uc6b0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"drunk","reason":"\uc218\ud559\uc790\ub294 \uc8fc\uc815\ubc45\uc774\uc758 \ub2a5\ub825\uc774 \uac70\uc9d3 \uc815\ubcf4\ub97c \uc54c\uac8c \ub418\uac70\ub098 \uc798\ubabb \ubc1c\ub3d9\ub418\uc5c8\uc744 \uacbd\uc6b0 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"marionette","reason":"\uc218\ud559\uc790\ub294 \uaf2d\ub450\uac01\uc2dc\uc758 \ub2a5\ub825\uc774 \uac70\uc9d3 \uc815\ubcf4\ub97c \uc54c\uac8c \ub418\uac70\ub098 \uc798\ubabb \ubc1c\ub3d9\ub418\uc5c8\uc744 \uacbd\uc6b0 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"cannibal","jinx":[{"id":"butler","reason":"\uc2dd\uc778\uc885\uc774 \uc9d1\uc0ac\uc758 \ub2a5\ub825\uc744 \uc5bb\uc5c8\ub2e4\uba74, \uc2dd\uc778\uc885\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"juggler","reason":"\uace1\uc608\uc0ac\uac00 \uc790\uc2e0\uc758 \uccab \ubc88\uc9f8 \ub0ae\uc5d0 \ucd94\uce21\ud558\uace0 \ucc98\ud615\ub418\uc5b4 \uc0ac\ub9dd\ud55c\ub2e4\uba74, \uc0dd\uc874\ud55c \uc2dd\uc778\uc885\uc740 \uace1\uc608\uc0ac\uac00 \ud55c \ucd94\uce21\uc758 \uacb0\uacfc\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"zealot","reason":"\uc2dd\uc778\uc885\uc774 \uad11\uc2e0\uc790\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc2dd\uc778\uc885\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"princess","reason":"\uc2dd\uc778\uc885\uc774 \uc624\ub298 \uacf5\uc8fc\ub97c \uc9c0\uba85\ud558\uace0 \ucc98\ud615\ud558\uc5ec \uc8fd\uc600\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \ucc38\uac00\uc790\ub97c \uc8fd\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"pithag","jinx":[{"id":"damsel","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc544\uac00\uc528\ub97c \ub9cc\ub4e0\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc544\uac00\uc528\uac00 \ub420 \ucc38\uac00\uc790\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4."},{"id":"politician","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ucc38\uac00\uc790\ub97c \uc815\uce58\uc778\uc73c\ub85c \ubc14\uafbc\ub2e4\uba74, \uadf8\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"villageidiot","reason":"\uc5ec\ubd84 \ud1a0\ud070\uc774 \uc788\ub2e4\uba74, \ub9c8\uadc0\ud560\uba48\uc774 \ub9c8\uc744 \ubc31\uce58\ub97c \ucd94\uac00\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uacbd\uc6b0 \ucde8\ud55c \ub9c8\uc744 \ubc31\uce58 \ucc38\uac00\uc790\uac00 \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"cultleader","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ucc38\uac00\uc790\ub97c \uc0ac\uad50 \uad50\uc8fc\ub85c \ubc14\uafbc\ub2e4\uba74, \uadf8\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"goon","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ucc38\uac00\uc790\ub97c \uac74\ub2ec\ub85c \ubc14\uafbc\ub2e4\uba74, \uadf8\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"ogre","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ucc38\uac00\uc790\ub97c \uc624\uc6b0\uac70\ub85c \ubc14\uafbc\ub2e4\uba74, \uadf8\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"cerenovus","jinx":[{"id":"goblin","reason":"\uc138\ub808\ub178\ubc84\uc2a4\ub294 \uc120\ud0dd\ud55c \ucc38\uac00\uc790\uac00 \uc790\uc2e0\uc774 \uace0\ube14\ub9b0 \uce90\ub9ad\ud130\ub77c\uace0 \uc9d1\ucc29\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"leviathan","jinx":[{"id":"soldier","reason":"\ub808\ube44\uc544\ud0c4\uc774 \uad70\uc778\uc744 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"monk","reason":"\uc218\ub3c4\uc0ac\uac00 \ubcf4\ud638\ud558\ub294 \ucc38\uac00\uc790\ub97c \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"innkeeper","reason":"\uc5ec\uad00 \uc8fc\uc778\uc774 \ubcf4\ud638\ud558\ub294 \ucc38\uac00\uc790\ub97c \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"ravenkeeper","reason":"\ub9e4\uc77c \ubc24*, \ub808\ube44\uc544\ud0c4\uc740 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \uae4c\ub9c8\uadc0\uc9c0\uae30\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"banshee","reason":"\ub9e4\uc77c \ubc24*, \ub808\ube44\uc544\ud0c4\uc740 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ubc34\uc2dc\ub294 \uc0ac\ub9dd\ud558\uace0 \ub2a5\ub825\uc744 \uc5bb\uc2b5\ub2c8\ub2e4."},{"id":"sage","reason":"\ub9e4\uc77c \ubc24*, \ub808\ube44\uc544\ud0c4\uc740 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ud604\uc790\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"farmer","reason":"\ub9e4\uc77c \ubc24*, \ub808\ube44\uc544\ud0c4\uc740 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ub18d\ubd80\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"mayor","reason":"\ub2e4\uc12f \ubc88\uc9f8 \ub0ae\uc5d0 \ub808\ube44\uc544\ud0c4\uacfc \uc2dc\uc7a5\uc774 \uc0dd\uc874\ud55c \uc0c1\ud0dc\uc5d0\uc11c \ucc98\ud615\uc774 \uc9c4\ud589\ub418\uc9c0 \uc54a\uc73c\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"exorcist","reason":"\uad6c\ub9c8\uc0ac\uc81c\uac00 \uc120\ud0dd\ud55c \ucc38\uac00\uc790\ub97c \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"grandmother","reason":"\ub808\ube44\uc544\ud0c4\uc774 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud55c\ub2e4\uba74, \uc190\uc8fc\uac00 \ucc98\ud615\ub418\uba74 \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"king","reason":"\ub808\ube44\uc544\ud0c4\uc774 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud55c\ub2e4\uba74, \ucc38\uac00\uc790 1\uba85\uc774 \uc0ac\ub9dd\ud55c \ub4a4\ubd80\ud130, \uc655\uc740 \ub9e4\uc77c \ubc24 \uc0dd\uc874\ud55c \uce90\ub9ad\ud130\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"hatter","reason":"\ub2e4\uc12f \ubc88\uc9f8 \ub0ae \uc774\ud6c4\uc5d0 \ub808\ube44\uc544\ud0c4\uc740 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"pithag","reason":"\ub2e4\uc12f \ubc88\uc9f8 \ub0ae \uc774\ud6c4\uc5d0 \ub808\ube44\uc544\ud0c4\uc740 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"lilmonsta","jinx":[{"id":"poppygrower","reason":"\ub9b4 \ubaac\uc2a4\ud0c0\uc640 \uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \uc0dd\uc874\ud574 \uc788\ub2e4\uba74, \ud558\uc218\uc778\ub4e4\uc740 \uadf8\uc911 1\uba85\uc774 \ub9b4 \ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubcf4\uae30\ub85c \uc120\ud0dd\ud560 \ub54c\uae4c\uc9c0, 1\uba85\uc529 \uae68\uc5b4\ub0a9\ub2c8\ub2e4."},{"id":"scarletwoman","reason":"\ucc38\uac00\uc790\uac00 5\uba85 \uc774\uc0c1 \uc0dd\uc874\ud574 \uc788\ub294 \uc0c1\ud669\uc5d0\uc11c \ub9b4 \ubaac\uc2a4\ud0c0\uac00 \uc0ac\ub9dd\ud588\ub2e4\uba74, \ud0d5\ub140\uac00 \ub098\uba38\uc9c0 \uac8c\uc784 \ub0b4\ub0b4 \ub9b4 \ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubd05\ub2c8\ub2e4."},{"id":"vizier","reason":"\uc7ac\uc0c1\uc774 \ub9b4 \ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubcf4\uace0 \uc788\ub2e4\uba74, \ucc98\ud615\uc73c\ub85c \uc0ac\ub9dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"hatter","reason":"\ubaa8\uc790 \uc7a5\uc218\uac00 \uc0ac\ub9dd\ud558\uace0 \uc545\ub9c8\uac00 \ub9b4 \ubaac\uc2a4\ud0c0\ub97c \uc120\ud0dd\ud55c\ub2e4\uba74, \uadf8\ub294 \uc790\uc2e0\uc774 \ub420 \ud558\uc218\uc778 \uce90\ub9ad\ud130\ub3c4 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"psychopath","reason":"\uc0ac\uc774\ucf54\ud328\uc2a4\uac00 \ub9b4 \ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubcf4\uace0 \uc788\ub2e4\uba74, \ucc98\ud615\uc73c\ub85c \uc0ac\ub9dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"legion","jinx":[{"id":"engineer","reason":"\uad70\ub2e8\uc774 \ub9cc\ub4e4\uc5b4\uc9c0\uba74, \ubaa8\ub4e0 \uc545\ud55c \ucc38\uac00\uc790\ub294 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4. \uad70\ub2e8\uc774 \ucc38\uc5ec \uc911\uc774\ub77c\uba74, \uac8c\uc784 \uc2dc\uc791 \uc2dc \uae30\uacc4\uacf5\uc774 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub418\uc9c0\ub9cc, \ub2a5\ub825\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc804\ub3c4\uc0ac\uac00 \uad70\ub2e8\uc744 \uc120\ud0dd\ud55c\ub2e4\uba74, \uad70\ub2e8\uc740 \ub2a5\ub825\uc744 \uc720\uc9c0\ud558\uc9c0\ub9cc \uc804\ub3c4\uc0ac\ub294 \uadf8\uac00 \uad70\ub2e8\uc774\ub77c\ub294 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub420 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"minstrel","reason":"\uad70\ub2e8\uc774 \uc624\ub298 \ucc98\ud615\ub418\uc5b4 \uc0ac\ub9dd\ud558\uba74, \uad70\ub2e8\uc740 \ub2a5\ub825\uc744 \uc720\uc9c0\ud558\uc9c0\ub9cc \uc74c\uc720\uc2dc\uc778\uc740 \uadf8\uac00 \uad70\ub2e8\uc774\ub77c\ub294 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub420 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"hatter","reason":"\uad70\ub2e8\uc774 \ub9cc\ub4e4\uc5b4\uc9c0\uba74, \ubaa8\ub4e0 \uc545\ud55c \ucc38\uac00\uc790\ub294 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4. \uad70\ub2e8\uc774 \ucc38\uc5ec \uc911\uc774\ub77c\uba74, \ubaa8\uc790 \uc7a5\uc218\ub294 \ub2a5\ub825\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"zealot","reason":"\uad11\uc2e0\uc790\ub294 \uad70\ub2e8\uc5d0\uac8c \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \uc704\uc7a5\ub418\uc5b4 \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc815\uce58\uc778\uc740 \uad70\ub2e8\uc5d0\uac8c \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \uc704\uc7a5\ub418\uc5b4 \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"scarletwoman","jinx":[{"id":"fanggu","reason":"\ud0d5\ub140\uc600\ub358 \uc545\ub9c8\ub97c \ud3ec\ud568\ud558\uc5ec 2\uba85\uc758 \uc545\ub9c8\uac00 \uc788\uac8c \ub41c\ub2e4\uba74, \ud0d5\ub140\ub294 \ud0d5\ub140\ub85c \ub0a8\uc2b5\ub2c8\ub2e4."},{"id":"alhadikhia","reason":"\ud0d5\ub140\uc600\ub358 \uc545\ub9c8\ub97c \ud3ec\ud568\ud558\uc5ec 2\uba85\uc758 \uc545\ub9c8\uac00 \uc788\uac8c \ub41c\ub2e4\uba74, \ud0d5\ub140\ub294 \ub2e4\uc2dc \ud0d5\ub140\uac00 \ub429\ub2c8\ub2e4."}]},{"id":"spy","jinx":[{"id":"poppygrower","reason":"\uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \ub2a5\ub825\uc774 \uc788\ub2e4\uba74, \ucca9\uc790\ub294 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"damsel","reason":"\ucca9\uc790\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec \uc911\uc774\uac70\ub098 \uc774\uc804\uc5d0 \ucc38\uc5ec \ud588\uc5c8\ub2e4\uba74, \uc544\uac00\uc528\ub294 \uc911\ub3c5\ub429\ub2c8\ub2e4."},{"id":"ogre","reason":"\ucca9\uc790\ub294 \uc624\uc6b0\uac70\uc5d0\uac8c \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \uc704\uc7a5\ub429\ub2c8\ub2e4."}]},{"id":"widow","jinx":[{"id":"poppygrower","reason":"\uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \ub2a5\ub825\uc774 \uc788\ub2e4\uba74, \ubbf8\ub9dd\uc778\uc740 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"damsel","reason":"\ubbf8\ub9dd\uc778\uc774 \uac8c\uc784\uc5d0 \ucc38\uc5ec \uc911\uc774\uac70\ub098 \uc774\uc804\uc5d0 \ucc38\uc5ec \ud588\uc5c8\ub2e4\uba74, \uc544\uac00\uc528\ub294 \uc911\ub3c5\ub429\ub2c8\ub2e4."}]},{"id":"yaggababble","jinx":[{"id":"exorcist","reason":"\uad6c\ub9c8\uc0ac\uc81c\uac00 \uc57c\uac00\ubc14\ube14\uc744 \uc120\ud0dd\ud55c\ub2e4\uba74, \uc57c\uac00\ubc14\ube14\uc740 \uc624\ub298 \ubc24 \ucc38\uac00\uc790\ub97c \uc8fd\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"summoner","jinx":[{"id":"clockmaker","reason":"\uc18c\ud658\uc0ac\ub294 \uc2dc\uacc4\uacf5\uc5d0\uac8c \uc545\ub9c8\ub85c \uc704\uc7a5\ub418\uc5b4 \ubcf4\uc785\ub2c8\ub2e4."},{"id":"poppygrower","reason":"\uc138 \ubc88\uc9f8 \ubc24\uc5d0\ub3c4 \uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \uc0dd\uc874\ud574 \uc788\ub2e4\uba74, \uc18c\ud658\uc0ac\ub294 \uc545\ub9c8 \uce90\ub9ad\ud130\ub9cc \uace0\ub985\ub2c8\ub2e4."},{"id":"marionette","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uc5ec \uc608\uc815\uc774\ub77c\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8 \uc774\ud6c4\uc5d0 \ub4f1\uc7a5\ud558\uace0 \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"pithag","reason":"\uc18c\ud658\uc0ac\uac00 \uc0dd\uc874\ud55c \ub450 \ubc88\uc9f8 \uc545\ub9c8\ub97c \ub9cc\ub4e0\ub2e4\uba74, \uc624\ub298 \ubc24 \uc608\uce21\ubd88\ud5c8\uc758 \uc8fd\uc74c\uc774 \ucc3e\uc544\uc635\ub2c8\ub2e4."},{"id":"hatter","reason":"\uc18c\ud658\uc0ac\uac00 \uc0dd\uc874\ud55c \ub450 \ubc88\uc9f8 \uc545\ub9c8\ub97c \ub9cc\ub4e0\ub2e4\uba74, \uc624\ub298 \ubc24 \uc608\uce21\ubd88\ud5c8\uc758 \uc8fd\uc74c\uc774 \ucc3e\uc544\uc635\ub2c8\ub2e4."},{"id":"courtier","reason":"\uc0dd\uc874\ud55c \uc18c\ud658\uc0ac\uac00 \ub2a5\ub825\uc774 \uc5c6\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"engineer","reason":"\uc0dd\uc874\ud55c \uc18c\ud658\uc0ac\uac00 \uac8c\uc784\uc5d0\uc11c \uc5c6\uc5b4\uc9c4\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"zombuul","reason":"\uc18c\ud658\uc0ac\uac00 \uc0ac\ub9dd\ud55c \ucc38\uac00\uc790\ub97c \uc880\ubc84\uc5bc\ub85c \ub9cc\ub4e0\ub2e4\uba74, \uc880\ubc84\uc5bc\uc740 \uc774\ubbf8 1\ubc88 \uc0ac\ub9dd\ud55c \uac83\uc73c\ub85c \uac04\uc8fc\ud569\ub2c8\ub2e4."},{"id":"pukka","reason":"\uc18c\ud658\uc0ac\ub294 \ud478\uce74\ub97c \uc138 \ubc88\uc9f8 \ubc24\uc5d0 \uc18c\ud658\ud558\ub294 \ub300\uc2e0, \ub450 \ubc88\uc9f8 \ubc24\uc5d0 \uc18c\ud658\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"legion","reason":"\uad70\ub2e8\uc774 \uc18c\ud658\ub418\uba74, \ubaa8\ub4e0 \uc545\ud55c \ucc38\uac00\uc790\ub294 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4."},{"id":"kazali","reason":"\uc18c\ud658\uc0ac\uac00 \uc0dd\uc874\ud55c \ub450 \ubc88\uc9f8 \uc545\ub9c8\ub97c \ub9cc\ub4e0\ub2e4\uba74, \uc624\ub298 \ubc24 \uc608\uce21\ubd88\ud5c8\uc758 \uc8fd\uc74c\uc774 \ucc3e\uc544\uc635\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc0dd\uc874\ud55c \uc18c\ud658\uc0ac\uac00 \ub2a5\ub825\uc774 \uc5c6\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"lordoftyphon","reason":"\ud2f0\ud3f0\uc758 \uad70\uc8fc\uac00 \uc18c\ud658\ub418\uba74, \ud558\uc218\uc778 1\uba85\uacfc \uc774\uc6c3\ud574\uc57c \ud558\uba70, \ub2e4\ub978 \uc774\uc6c3\uc740 \uc545\ud55c \ud558\uc218\uc778\uc774 \ub429\ub2c8\ub2e4."}]},{"id":"marionette","jinx":[{"id":"lilmonsta","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uc5ec \uc608\uc815\uc774\ub77c\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8 \uc774\ud6c4\uc5d0 \ub4f1\uc7a5\ud558\uace0 \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"balloonist","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \uc790\uc2e0\uc744 \uc5f4\uae30\uad6c \uc870\uc885\uc0ac\ub77c\uace0 \ucc29\uac01\ud55c\ub2e4\uba74, \uc678\uc9c0\uc778 1\uba85\uc774 \ucd94\uac00\ub85c \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"huntsman","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \uc790\uc2e0\uc744 \uc0ac\ub0e5\uafbc\uc774\ub77c\uace0 \ucc29\uac01\ud55c\ub2e4\uba74, \uc544\uac00\uc528\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4."}]},{"id":"lleech","jinx":[{"id":"mastermind","reason":"\uc8fc\ubaa8\uc790\uac00 \uc0dd\uc874\ud574 \uc788\uace0, \uac70\ubb34\ub9ac\uc758 \uc219\uc8fc\uac00 \ucc98\ud615\ub418\uc5c8\ub2e4\uba74, \uac70\ubb34\ub9ac\ub294 \uc0dd\uc874\ud558\uc9c0\ub9cc \ub2a5\ub825\uc744 \uc783\uc2b5\ub2c8\ub2e4."},{"id":"slayer","reason":"\ucc98\ub2e8\uc790\uac00 \uac70\ubb34\ub9ac\uc758 \uc219\uc8fc\ub97c \ucc98\ub2e8\ud558\uba74, \uc219\uc8fc\uac00 \uc0ac\ub9dd\ud569\ub2c8\ub2e4."}]},{"id":"kazali","jinx":[{"id":"marionette","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uc5ec \uc608\uc815\uc774\ub77c\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8 \uc774\ud6c4\uc5d0 \ub4f1\uc7a5\ud558\uace0 \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."}]},{"id":"riot","jinx":[{"id":"mayor","reason":"\uc2dc\uc7a5\uc740 \ud3ed\ub3d9\uc744 \uc911\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub54c \ud3ed\ub3c4\uac00 1\uba85\ub9cc \uc0dd\uc874\ud574 \uc788\ub2e4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud558\uace0, \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74, \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"monk","reason":"\uc218\ub3c4\uc0ac\uac00 \ubcf4\ud638\ud558\ub294 \ucc38\uac00\uc790\ub97c \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"farmer","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ub18d\ubd80\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"innkeeper","reason":"\uc5ec\uad00 \uc8fc\uc778\uc774 \ubcf4\ud638\ud558\ub294 \ucc38\uac00\uc790\ub97c \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"sage","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ud604\uc790\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"banshee","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ubc34\uc2dc\ub294 \uc0ac\ub9dd\ud558\uace0 \ub2a5\ub825\uc744 \uc5bb\uc2b5\ub2c8\ub2e4."},{"id":"ravenkeeper","reason":"\ub9e4\uc77c \ubc24*, \ud3ed\ub3c4\ub294 (\uc774\uc804 \ubc24\ub4e4\uacfc \ub2e4\ub978) \uc0dd\uc874\ud55c \uc120\ud55c \ucc38\uac00\uc790 1\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \uae4c\ub9c8\uadc0\uc9c0\uae30\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"soldier","reason":"\ud3ed\ub3c4\uac00 \uad70\uc778\uc744 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"grandmother","reason":"\ud3ed\ub3c4\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud55c\ub2e4\uba74, \uc190\uc8fc\uac00 \ucc98\ud615\ub418\uba74 \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"king","reason":"\ud3ed\ub3c4\uac00 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud55c\ub2e4\uba74, \ucc38\uac00\uc790 1\uba85\uc774 \uc0ac\ub9dd\ud55c \ub4a4\ubd80\ud130, \uc655\uc740 \ub9e4\uc77c \ubc24 \uc0dd\uc874\ud55c \uce90\ub9ad\ud130\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"exorcist","reason":"\uad6c\ub9c8\uc0ac\uc81c\uac00 \uc120\ud0dd\ud55c \ucc38\uac00\uc790\ub97c \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"atheist","reason":"\ud3ed\ub3d9\uc774 \uc77c\uc5b4\ub0a0 \ub54c, \uc774\uc57c\uae30\uafbc\uc774 \uc9c0\uba85\ub418\uba74 \ucc38\uac00\uc790\ub4e4\uc740 \ud22c\ud45c\ub97c \uc9c4\ud589\ud569\ub2c8\ub2e4. \uadf8\uac00 \u0022\uc0ac\ub9dd \uc608\uc815\u0022\uc774 \ub418\uba74 \uac8c\uc784\uc774 \ub05d\ub0a9\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\ub2e4\uba74, \uc9c0\uba85\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud569\ub2c8\ub2e4."}]},{"id":"butler","jinx":[{"id":"organgrinder","reason":"\uac70\ub9ac\uc758 \uc545\uc0ac\uac00 \ub208\uc744 \uac10\uace0 \ud22c\ud45c\ub97c \ud558\uac8c \ud558\ub294 \uacbd\uc6b0, \uc9d1\uc0ac\ub294 \ud22c\ud45c\ud558\uae30 \uc704\ud574 \uc190\uc744 \ub4e4 \uc218 \uc788\uc9c0\ub9cc \uadf8 \ud22c\ud45c\ub294 \uc8fc\uc778\uacfc \ub3d9\uc77c\ud560 \ub54c\ub9cc \uc720\ud6a8\ud569\ub2c8\ub2e4."}]},{"id":"vizier","jinx":[{"id":"investigator","reason":"\uc774\uc57c\uae30\uafbc\uc740 \uc7ac\uc0c1\uc774 \ucc38\uc5ec \uc911\uc774\ub77c\uace0 \uc120\uc5b8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc7ac\uc0c1\uc774 \ub2a5\ub825\uc744 \uc783\uac8c \ub418\uba74, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub0ae \ub3d9\uc548 \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"courtier","reason":"\uc7ac\uc0c1\uc774 \ub2a5\ub825\uc744 \uc783\uac8c \ub418\uba74, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub0ae \ub3d9\uc548 \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"fearmonger","reason":"\uc7ac\uc0c1\uc740 \uacf5\ud3ec\uc758 \uc804\ub839\uacfc \ud568\uaed8 \uc77c\uc5b4\ub098 \uacf5\ud3ec\uc758 \uc804\ub839\uc774 \uc120\ud0dd\ud55c \ucc38\uac00\uc790\ub97c \uc54c\uac8c \ub418\uba70, \uadf8 \ucc38\uac00\uc790\ub97c \uc989\uc2dc \ucc98\ud615\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc815\uce58\uc778\uc740 \uc7ac\uc0c1\uc5d0\uac8c \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \uc704\uc7a5\ub418\uc5b4 \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"alsaahir","reason":"\uc774\uc57c\uae30\uafbc\uc740 \uc7ac\uc0c1\uc774 \ucc38\uc5ec \uc911\uc774\ub77c\uace0 \uc120\uc5b8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"zealot","reason":"\uad11\uc2e0\uc790\ub294 \uc7ac\uc0c1\uc5d0\uac8c \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \uc704\uc7a5\ub418\uc5b4 \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"vortox","jinx":[{"id":"banshee","reason":"\ubcf4\ub974\ud1a1\uc2a4\uac00 \ubc34\uc2dc\ub97c \uc8fd\uc774\uba74, \ubaa8\ub4e0 \ucc38\uac00\uc790\ub294 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"ogre","jinx":[{"id":"recluse","reason":"\uc740\ub454\uc790\uac00 \uc624\uc6b0\uac70\uc5d0\uac8c \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \uc704\uc7a5\ub418\uc5b4 \ubcf4\uc778\ub2e4\uba74, \uc624\uc6b0\uac70\ub294 \uc790\uc2e0\uc774 \uc545\ud55c \ud300 \uc18c\uc18d\uc774\ub77c\ub294 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"mastermind","jinx":[{"id":"alhadikhia","reason":"\uc8fc\ubaa8\uc790\uac00 \uc0b4\uc544\uc788\uc744 \ub54c \uc54c \ud558\ub514\ud0a4\uc544\uac00 \ucc98\ud615\uc73c\ub85c \uc8fd\ub294\ub2e4\uba74, \uc624\ub298 \ubc24 \uc54c \ud558\ub514\ud0a4\uc544\ub294 \uc120\ud55c \ucc38\uac00\uc790 3\uba85\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub9cc\uc57d \uc804\ubd80 \uc0dd\uc874\uc744 \uc120\ud0dd\ud558\uba74, \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\ub2e4\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"vigormortis","reason":"\ub2a5\ub825\uc744 \uac00\uc9c4 \uc8fc\ubaa8\uc790\ub294 \ube44\uace0\ub974\ubaa8\ub974\ud2f0\uc2a4\uac00 \uc8fd\ub354\ub77c\ub3c4 \ub2a5\ub825\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."}]},{"id":"boffin","jinx":[{"id":"cultleader","reason":"\uc545\ub9c8\uac00 \uc0ac\uad50 \uad50\uc8fc\uc758 \ub2a5\ub825\uc744 \uac16\ub294\ub2e4\uba74, \uc545\ub9c8\ub294 \uc774 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300 \uc18c\uc18d\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"goon","reason":"\uc545\ub9c8\uac00 \uac74\ub2ec\uc758 \ub2a5\ub825\uc744 \uac16\ub294\ub2e4\uba74, \uc545\ub9c8\ub294 \uc774 \ub2a5\ub825\uc73c\ub85c \uc120\ud55c \ud300 \uc18c\uc18d\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"ogre","reason":"\uc545\ub9c8\ub294 \uc624\uc6b0\uac70\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc545\ub9c8\ub294 \uc815\uce58\uc778\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"drunk","reason":"\uc545\ub9c8\ub294 \uc8fc\uc815\ubc45\uc774\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"villageidiot","reason":"\uc5ec\ubd84 \ud1a0\ud070\uc774 \uc788\ub2e4\uba74, \uacfc\ud559\uc790\ub294 \uc545\ub9c8\uc5d0\uac8c \ub9c8\uc744 \ubc31\uce58\uc758 \ub2a5\ub825\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"plaguedoctor","jinx":[{"id":"eviltwin","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uc0ac\uc545\ud55c \uc30d\ub465\uc774\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ucc38\uac00\uc790 1\uba85\uc774 \uc0ac\uc545\ud55c \uc30d\ub465\uc774\uac00 \ub429\ub2c8\ub2e4."},{"id":"fearmonger","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uacf5\ud3ec\uc758 \uc804\ub839\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \ub300\uc2e0 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"goblin","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uace0\ube14\ub9b0\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \ub300\uc2e0 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"spy","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ucca9\uc790\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \ub300\uc2e0 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"scarletwoman","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ud0d5\ub140\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \ub300\uc2e0 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"boomdandy","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ud3ed\ud0c4\ub9c8\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ucc38\uac00\uc790 1\uba85\uc774 \ud3ed\ud0c4\ub9c8\uac00 \ub429\ub2c8\ub2e4."},{"id":"baron","reason":"\uc774\uc57c\uae30\uafbc\uc774 \ub0a8\uc791\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ucd5c\ub300 2\uba85\uc758 \ucc38\uac00\uc790\uac00 \uc678\uc9c0\uc778\uc774 \ub429\ub2c8\ub2e4."},{"id":"marionette","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uaf2d\ub450\uac01\uc2dc\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc545\ub9c8\uc758 \uc120\ud55c \uc774\uc6c3 \uc0dd\uc874\uc790 \uc911 1\uba85\uc774 \uaf2d\ub450\uac01\uc2dc\uac00 \ub429\ub2c8\ub2e4."},{"id":"wraith","reason":"\uc774\uc57c\uae30\uafbc\uc774 \uc545\ub839\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ud558\uc218\uc778 1\uba85\uc774 \uadf8 \ub2a5\ub825\uc744 \ub300\uc2e0 \uc5bb\uace0, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."}]},{"id":"heretic","jinx":[{"id":"godfather","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"baron","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"pithag","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"spy","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"widow","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"lleech","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"boffin","reason":"\uc545\ub9c8\ub294 \ubc30\uad50\uc790\uc758 \ub2a5\ub825\uc744 \uac00\uc9c8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"bountyhunter","jinx":[{"id":"philosopher","reason":"\ucca0\ud559\uc790\uac00 \ud604\uc0c1\uae08 \uc0ac\ub0e5\uafbc\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc120\ud55c \uc8fc\ubbfc 1\uba85\uc774 \uc545\ud55c \ud300 \uc18c\uc18d\uc73c\ub85c \ubc14\ub014 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"kazali","reason":"\uce74\uc798\ub9ac\uac00 \ud604\uc0c1\uae08 \uc0ac\ub0e5\uafbc\uc744 \ud558\uc218\uc778\uc73c\ub85c \ub9cc\ub4e4\uc5c8\ub2e4\uba74 \uc545\ud55c \uc8fc\ubbfc\uc740 \ub9cc\ub4e4\uc5b4\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"alhadikhia","jinx":[{"id":"princess","reason":"\uacf5\uc8fc\uac00 \uc790\uc2e0\uc758 \uccab \ubc88\uc9f8 \ub0ae\uc5d0 \ucc38\uac00\uc790\ub97c \uc9c0\uba85\ud558\uace0 \ucc98\ud615\ud55c \uacbd\uc6b0, \uc624\ub298 \ubc24\uc5d0 \uc54c \ud558\ub514\ud0a4\uc544\uc5d0\uac8c \uc544\ubb34\ub3c4 \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"alchemist","jinx":[{"id":"wraith","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uc545\ub839\uc758 \ub2a5\ub825\uc744 \uac16\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \ub2a5\ub825\uc774 \uc5c6\uace0, \uc545\ub839\uc774 \uac8c\uc784\uc5