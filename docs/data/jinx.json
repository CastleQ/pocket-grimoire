[{"id":"mathematician","jinx":[{"id":"chambermaid","reason":"\ud558\ub140\uac00 \uba3c\uc800 \uae68\uc5b4\ub098\ub354\ub77c\ub3c4 \ud558\ub140\ub294 \uc218\ud559\uc790\uac00 \uc624\ub298 \ubc24 \uae68\uc5b4\ub098\ub294\uc9c0 \uc5ec\ubd80\ub97c \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"lunatic","reason":"\uc218\ud559\uc790\ub294 \ubbf8\uce58\uad11\uc774\uac00 \uc120\ud0dd\ud55c \uc0ac\ub78c\uc774 \uc545\ub9c8\uac00 \uc2e4\uc81c\ub85c \uacf5\uaca9\ud55c \uc0ac\ub78c\uacfc \ub2e4\ub97c \uacbd\uc6b0 \uc774\ub97c \uac10\uc9c0\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"cannibal","jinx":[{"id":"butler","reason":"\uc2dd\uc778\uc885\uc774 \uc9d1\uc0ac\uc758 \ub2a5\ub825\uc744 \uc5bb\uc5c8\ub2e4\uba74, \uc2dd\uc778\uc885\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"juggler","reason":"\uc800\uae00\ub7ec\uac00 \uccab \ub0a0\uc5d0 \ucd94\uce21\ud558\uace0 \ucc98\ud615\ub418\uc5b4 \uc8fd\uc744 \uacbd\uc6b0, \uc0b4\uc544\uc788\ub294 \uc2dd\uc778\uc885\uc740 \uc800\uae00\ub7ec\uac00 \ud55c \ucd94\uce21\uc758 \uacb0\uacfc\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"zealot","reason":"\uc2dd\uc778\uc885\uc774 \uad11\uc2e0\ub3c4\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc2dd\uc778\uc885\uc740 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"poppygrower","reason":"If the Cannibal eats the Poppy Grower, then dies or loses the Poppy Grower ability, the Demon and Minions learn each other that night."},{"id":"princess","reason":"\uc2dd\uc778\uc885\uc774 \uacf5\uc8fc\ub97c \uc9c0\uba85\ud558\uace0 \ucc98\ud615\ud55c\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \ud50c\ub808\uc774\uc5b4\ub97c \uc8fd\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"pithag","jinx":[{"id":"damsel","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc544\uac00\uc528\ub97c \ub9cc\ub4e0\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc544\uac00\uc528\uac00 \ub420 \ud50c\ub808\uc774\uc5b4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4."},{"id":"politician","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc815\uce58\uac00\ub85c \ubc14\uafbc\ub2e4\uba74, \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud558\uac8c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"villageidiot","reason":"\uc5ec\ubd84\uc758 \ud1a0\ud070\uc774 \uc788\ub2e4\uba74, \ub9c8\uadc0\ud560\uba48\uc774 \ubc14\ubcf4\ub97c \ucd94\uac00\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uacbd\uc6b0 \ucde8\ud55c \ubc14\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \ubcc0\uacbd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"cultleader","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uad50\uc8fc\ub85c \ubc14\uafbc\ub2e4\uba74, \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud558\uac8c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"goon","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uae61\ud328\ub85c \ubc14\uafbc\ub2e4\uba74, \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud558\uac8c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"ogre","reason":"\ub9c8\uadc0\ud560\uba48\uc774 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc624\uc6b0\uac70\ub85c \ubc14\uafbc\ub2e4\uba74, \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ub2a5\ub825\uc73c\ub85c \uc120\ud558\uac8c \ubc14\ub014 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"cerenovus","jinx":[{"id":"goblin","reason":"\uc138\ub808\ub178\ubd80\uc2a4\ub294 \uc120\ud0dd\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uace0\ube14\ub9b0 \uc5ed\ud560\uc5d0 \uad11\uae30\ud558\ub3c4\ub85d \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"leviathan","jinx":[{"id":"soldier","reason":"\uad70\uc778\uc744 \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"monk","reason":"\uc218\ub3c4\uc0ac\uac00 \ubcf4\ud638\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"innkeeper","reason":"\uc5ec\uad00 \uc8fc\uc778\uc774 \ubcf4\ud638\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"ravenkeeper","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ub808\ube44\uc544\ud0c4\uc740 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \uae4c\ub9c8\uadc0\uc9c0\uae30\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"banshee","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ub808\ube44\uc544\ud0c4\uc740 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ubc34\uc2dc\ub294 \uc8fd\uace0 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub429\ub2c8\ub2e4."},{"id":"sage","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ub808\ube44\uc544\ud0c4\uc740 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ud604\uc790\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"farmer","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ub808\ube44\uc544\ud0c4\uc740 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ub18d\ubd80\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"mayor","reason":"\ub808\ube44\uc544\ud0c4\uc774 \ucc38\uac00 \uc911\uc778 \uacbd\uc6b0, 5\uc77c\ucc28 \ub0ae\uc5d0 \ucc98\ud615\uc774 \uc9c4\ud589\ub418\uc9c0 \uc54a\uc73c\uba74 \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"exorcist","reason":"\ud1f4\ub9c8\uc0ac\uac00 \uc120\ud0dd\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \ub808\ube44\uc544\ud0c4\uc774 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"grandmother","reason":"\ub808\ube44\uc544\ud0c4\uc774 \ucc38\uac00 \uc911\uc778 \uacbd\uc6b0, \uc190\uc8fc\uac00 \ucc98\ud615\ub418\uba74 \uc545\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"king","reason":"\ub808\ube44\uc544\ud0c4\uc774 \ucc38\uac00 \uc911\uc778 \uacbd\uc6b0, \ud50c\ub808\uc774\uc5b4 1\uba85\uc774 \uc8fd\uc740 \ub4a4\ubd80\ud130, \uc655\uc740 \ub9e4\uc77c \ubc24 \uc0b4\uc544\uc788\ub294 \uce90\ub9ad\ud130\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"hatter","reason":"\ub2e4\uc12f\ubc88\uc9f8 \ub0a0 \uc774\ud6c4\uc5d0 \ub808\ube44\uc544\ud0c4\uc740 \ucc38\uac00\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"pithag","reason":"\ub2e4\uc12f\ubc88\uc9f8 \ub0a0 \uc774\ud6c4\uc5d0 \ub808\ube44\uc544\ud0c4\uc740 \ucc38\uac00\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"lilmonsta","jinx":[{"id":"poppygrower","reason":"\ub9b4\ubaac\uc2a4\ud0c0\uc640 \uc591\uadc0\ube44 \uc7ac\ubc30\uc790\uac00 \uc0b4\uc544\uc788\ub2e4\uba74, \ud558\uc218\uc778\ub4e4\uc740 \uadf8\uc911 1\uba85\uc774 \ub9b4\ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubcfc \ub54c\uae4c\uc9c0, \ud55c \uba85\uc529 \uae68\uc5b4\ub0a9\ub2c8\ub2e4."},{"id":"scarletwoman","reason":"5\uba85 \uc774\uc0c1\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uc0b4\uc544\uc788\uace0 \ub9b4\ubaac\uc2a4\ud0c0\uac00 \uc8fd\uc5c8\ub2e4\uba74, \ud0d5\ub140\uac00 \ub098\uba38\uc9c0 \uac8c\uc784 \ub0b4\ub0b4 \ub9b4\ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubd05\ub2c8\ub2e4."},{"id":"vizier","reason":"\uc218\uc0c1\uc774 \ub9b4\ubaac\uc2a4\ud0c0\ub97c \ub3cc\ubcf4\uace0 \uc788\ub2e4\uba74, \ucc98\ud615\uc73c\ub85c \uc8fd\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"hatter","reason":"\uc545\ub9c8\uac00 \ub9b4\ubaac\uc2a4\ud0c0\ub97c \uc120\ud0dd\ud55c\ub2e4\uba74, \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc774 \ubcc0\ud560 \ud558\uc218\uc778 \uce90\ub9ad\ud130\ub3c4 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."}]},{"id":"legion","jinx":[{"id":"engineer","reason":"\uad70\ub2e8\uc774 \ub9cc\ub4e4\uc5b4\uc9c0\uba74, \ubaa8\ub4e0 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4. \uad70\ub2e8\uc774 \ucc38\uac00 \uc911\uc774\ub77c\uba74, \uacf5\ud559\uc790\ub294 \uc774 \uc0ac\uc2e4\uc744 \uc54c\uace0 \uc2dc\uc791\ud558\uc9c0\ub9cc, \ub2a5\ub825\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"preacher","reason":"\ubaa9\uc0ac\uac00 \uad70\ub2e8 \ud50c\ub808\uc774\uc5b4\ub97c \uc120\ud0dd\ud55c\ub2e4\uba74, \uad70\ub2e8\uc740 \ub2a5\ub825\uc744 \uc720\uc9c0\ud558\uc9c0\ub9cc \ubaa9\uc0ac\ub294 \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\uac00 \uad70\ub2e8\uc784\uc744 \uc54c\uac8c \ub420 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"minstrel","reason":"\uad70\ub2e8\uc774 \ucc98\ud615\uc73c\ub85c \uc624\ub298 \uc0ac\ub9dd\ud558\uba74, \uad70\ub2e8\uc744 \ub2a5\ub825\uc744 \uc720\uc9c0\ud558\uc9c0\ub9cc \uc74c\uc720\uc2dc\uc778\uc740 \ud574\ub2f9 \ud50c\ub808\uc774\uc5b4\uac00 \uad70\ub2e8\uc784\uc744 \uc54c\uac8c \ub420 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"hatter","reason":"\uad70\ub2e8\uc774 \ub9cc\ub4e4\uc5b4\uc9c0\uba74, \ubaa8\ub4e0 \uc545\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \uad70\ub2e8\uc774 \ub429\ub2c8\ub2e4. \uad70\ub2e8\uc774 \ucc38\uac00 \uc911\uc774\ub77c\uba74, \ubaa8\uc790\uc7a5\uc218\ub294 \ub2a5\ub825\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"zealot","reason":"\uad11\uc2e0\ub3c4\ub294 \uad70\ub2e8\uc5d0\uac8c \uc545\ud55c \uc9c4\uc601\uc73c\ub85c \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"scarletwoman","jinx":[{"id":"fanggu","reason":"\ud0d5\ub140\uc600\ub358 \uc545\ub9c8\ub97c \ud3ec\ud568\ud558\uc5ec 2\uba85\uc758 \uc545\ub9c8\uac00 \uc788\uac8c \ub41c\ub2e4\uba74, \ud0d5\ub140\ub294 \ud0d5\ub140\ub85c \ub0a8\uc2b5\ub2c8\ub2e4."},{"id":"alhadikhia","reason":"\ud0d5\ub140\uc600\ub358 \uc545\ub9c8\ub97c \ud3ec\ud568\ud558\uc5ec 2\uba85\uc758 \uc545\ub9c8\uac00 \uc788\uac8c \ub41c\ub2e4\uba74, \ud0d5\ub140\ub294 \ub2e4\uc2dc \ud0d5\ub140\uac00 \ub429\ub2c8\ub2e4."}]},{"id":"spy","jinx":[{"id":"poppygrower","reason":"\uc591\uadc0\ube44 \uc7ac\ubc30\uc790\uac00 \ub2a5\ub825\uc774 \uc788\ub2e4\uba74, \ucca9\uc790\ub294 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"damsel","reason":"\ucca9\uc790\uac00 \ucc38\uac00 \uc911\uc774\uac70\ub098 \uc774\uc804\uc5d0 \ucc38\uac00 \ud588\uc5c8\ub2e4\uba74, \uc544\uac00\uc528\ub294 \uc911\ub3c5\ub429\ub2c8\ub2e4."},{"id":"ogre","reason":"\ucca9\uc790\ub294 \uc624\uc6b0\uac70\uc5d0\uac8c \uc545\ud55c \uc9c4\uc601\uc73c\ub85c \ucde8\uae09\ub429\ub2c8\ub2e4."}]},{"id":"widow","jinx":[{"id":"poppygrower","reason":"\uc591\uadc0\ube44 \uc7ac\ubc30\uc790\uac00 \ub2a5\ub825\uc774 \uc788\ub2e4\uba74, \uacfc\ubd80\ub294 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"damsel","reason":"\uacfc\ubd80\uac00 \ucc38\uac00 \uc911\uc774\uac70\ub098 \uc774\uc804\uc5d0 \ucc38\uac00 \ud588\uc5c8\ub2e4\uba74, \uc544\uac00\uc528\ub294 \uc911\ub3c5\ub429\ub2c8\ub2e4."}]},{"id":"yaggababble","jinx":[{"id":"exorcist","reason":"\ud1f4\ub9c8\uc0ac\uac00 \uc57c\uac00\ubc14\ube14\uc744 \uc120\ud0dd\ud558\uba74, \uc57c\uac00\ubc14\ube14\uc740 \uc624\ub298 \ubc24 \uc8fd\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"summoner","jinx":[{"id":"clockmaker","reason":"\uc18c\ud658\uc0ac\ub294 \uc2dc\uacc4\uacf5\uc5d0\uac8c \uc545\ub9c8\ub85c \ubcf4\uc785\ub2c8\ub2e4."},{"id":"poppygrower","reason":"\uc138\ubc88\uc9f8 \ubc24\uc5d0\ub3c4 \uc591\uadc0\ube44 \uc7ac\ubc30\uc79