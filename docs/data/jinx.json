c74c\uc740 \ubb34\uc791\uc704 \uc785\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc0b4\uc544\uc788\ub294 \uc18c\ud658\uc0ac\uac00 \ub2a5\ub825\uc774 \uc5c6\ub2e4\uba74, \uc774\uc57c\uae30\uafbc\uc774 \uc18c\ud658\uc0ac \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"lordoftyphon","reason":"\ud0dc\ud48d\uc758 \uad70\uc8fc\uac00 \uc18c\ud658\ub41c\ub2e4\uba74, \ud558\uc218\uc778\uc744 \uc774\uc6c3\ud558\ub3c4\ub85d \ud574\uc57c\ud558\uba70, \ub2e4\ub978 \uc774\uc6c3\uc740 \uc545\ud55c \ud558\uc218\uc778\uc774 \ub429\ub2c8\ub2e4."}]},{"id":"marionette","jinx":[{"id":"lilmonsta","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \ucc38\uac00 \uc608\uc815\uc774\ub77c\uba74, \uaf2d\ub450\uac01\uc2dc\ub294 \uc545\ub9c8 \uc774\ud6c4\uc5d0 \ub4f1\uc7a5\ud558\uace0 \uc545\ub9c8\uc758 \uc774\uc6c3\uc73c\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"poppygrower","reason":"When the Poppy Grower dies, the Demon learns the Marionette but the Marionette learns nothing."},{"id":"snitch","reason":"The Marionette does not learn 3 not in-play characters. The Demon learns an extra 3 instead."},{"id":"balloonist","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \uc790\uc2e0\uc744 \uc5f4\uae30\uad6c \uc870\uc885\uc0ac\ub77c\uace0 \uc0dd\uac01\ud55c\ub2e4\uba74, \uc678\uc9c0\uc778\uc774 1\uba85 \ub354 \ucd94\uac00\ub418\uc5c8\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"damsel","reason":"The Marionette does not learn that a Damsel is in play."},{"id":"huntsman","reason":"\uaf2d\ub450\uac01\uc2dc\uac00 \uc790\uc2e0\uc744 \uc0ac\ub0e5\uafbc\uc774\ub77c\uace0 \uc0dd\uac01\ud55c\ub2e4\uba74, \uc544\uac00\uc528\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."},{"id":"wraith","reason":"The Wraith does not wake with the Marionette."}]},{"id":"lleech","jinx":[{"id":"mastermind","reason":"\ubc30\ud6c4\uc778\ubb3c\uc774 \uc0b4\uc544\uc788\uace0, \ub9ac\uce58\uc758 \uc219\uc8fc\uac00 \ucc98\ud615\ub418\uc5c8\ub2e4\uba74, \ub9ac\uce58\ub294 \uc0b4\uc544\ub0a8\uc73c\ub098 \ub2a5\ub825\uc744 \uc783\uc2b5\ub2c8\ub2e4."},{"id":"slayer","reason":"\ucc98\ub2e8\uc790\uac00 \ub9ac\uce58\uc758 \uc219\uc8fc\ub97c \uc8fd\uc778\ub2e4\uba74, \uc219\uc8fc\uac00 \uc8fd\uc2b5\ub2c8\ub2e4."}]},{"id":"kazali","jinx":[{"id":"goon","reason":"The Kazali can choose that the Goon player is one of their evil Minions."},{"id":"marionette","reason":"If the Kazali chooses to create a Marionette, they must choose one of their neighbors."},{"id":"huntsman","reason":"If the Kazali chooses the Damsel to become a Minion, and a Huntsman is in play, a good player becomes the Damsel."},{"id":"choirboy","reason":"The Kazali can not choose the King to become a Minion if a Choirboy is in play."},{"id":"soldier","reason":"The Kazali can choose that the Soldier player is one of their evil Minions."}]},{"id":"riot","jinx":[{"id":"mayor","reason":"\uc2dc\uc7a5\uc740 \ucc98\ud615\uc744 \uc911\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub54c \ud3ed\ub3c4\uac00 1\uba85\ub9cc \uc0b4\uc544\uc788\ub2e4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud558\uace0 \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uc545\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"monk","reason":"\uc218\ub3c4\uc0ac\uac00 \ubcf4\ud638\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"farmer","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ud3ed\ub3c4\ub294 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ub18d\ubd80\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"innkeeper","reason":"\uc5ec\uad00 \uc8fc\uc778\uc774 \ubcf4\ud638\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"sage","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ud3ed\ub3c4\ub294 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ud604\uc790\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"banshee","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ud3ed\ub3c4\ub294 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \ubc34\uc2dc\ub294 \uc8fd\uace0 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub429\ub2c8\ub2e4."},{"id":"ravenkeeper","reason":"\ub9e4\uc77c \ubc24*(\uccab\ub0a0 \uc81c\uc678), \ud3ed\ub3c4\ub294 \uc774\uc804\uacfc \ub2e4\ub978 \uc0b4\uc544\uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4\ub97c 1\uba85 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc120\ud0dd\ub41c \uae4c\ub9c8\uadc0\uc9c0\uae30\ub294 \ub2a5\ub825\uc774 \ubc1c\ub3d9\ub418\uc9c0\ub9cc \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"soldier","reason":"\uad70\uc778\uc744 \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"grandmother","reason":"\ud3ed\ub3c4\uac00 \ucc38\uac00 \uc911\uc778 \uacbd\uc6b0, \uc190\uc8fc\uac00 \ucc98\ud615\ub418\uba74 \uc545\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"king","reason":"\ud3ed\ub3c4\uac00 \ucc38\uac00 \uc911\uc778 \uacbd\uc6b0, \ud50c\ub808\uc774\uc5b4 1\uba85\uc774 \uc8fd\uc740 \ub4a4\ubd80\ud130, \uc655\uc740 \ub9e4\uc77c \ubc24 \uc0b4\uc544\uc788\ub294 \uce90\ub9ad\ud130\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"exorcist","reason":"\ud1f4\ub9c8\uc0ac\uac00 \uc120\ud0dd\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \ud3ed\ub3c4\uac00 \uc9c0\uba85\ud558\uc5ec \ucc98\ud615\uc2dc\ud0a4\uba74, \uc120\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."}]},{"id":"butler","jinx":[{"id":"organgrinder","reason":"\ud48d\uac01\uc7c1\uc774\uac00 \ub208\uc744 \uac10\uace0 \ud22c\ud45c\ub97c \ud558\uac8c \ud558\ub294 \uacbd\uc6b0, \uc9d1\uc0ac\ub294 \ud22c\ud45c\ud558\uae30 \uc704\ud574 \uc190\uc744 \ub4e4 \uc218 \uc788\uc9c0\ub9cc \uadf8 \ud22c\ud45c\ub294 \uc8fc\uc778\uacfc \ub3d9\uc77c\ud55c \ud22c\ud45c\uc77c \ub54c\ub9cc \uc720\ud6a8\ud569\ub2c8\ub2e4."}]},{"id":"vizier","jinx":[{"id":"investigator","reason":"\uc774\uc57c\uae30\uafbc\uc740 \uc218\uc0c1\uc774 \ucc38\uac00 \uc911\uc774\ub77c\uace0 \uc120\uc5b8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"preacher","reason":"\uc218\uc0c1\uc774 \ub2a5\ub825\uc744 \uc783\uac8c \ub418\uba74, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub0ae \ub3d9\uc548 \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"courtier","reason":"\uc218\uc0c1\uc774 \ub2a5\ub825\uc744 \uc783\uac8c \ub418\uba74, \uc774 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub429\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub0ae \ub3d9\uc548 \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"fearmonger","reason":"\uc218\uc0c1\uc740 \uacf5\ud3ec\uc870\uc7a5\uc790\uc640 \ud568\uaed8 \uc77c\uc5b4\ub098\uba70, \uacf5\ud3ec\uc870\uc7a5\uc790\uac00 \uc120\ud0dd\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc989\uc2dc \ucc98\ud615\uc2dc\ud0ac \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"politician","reason":"\uc815\uce58\uac00\ub294 \uc218\uc0c1\uc5d0\uac8c \uc545\ud55c \uc9c4\uc601\uc73c\ub85c \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"alsaahir","reason":"\uc774\uc57c\uae30\uafbc\uc740 \uc218\uc0c1\uc774 \ucc38\uac00 \uc911\uc774\ub77c\uace0 \uc120\uc5b8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"zealot","reason":"\uad11\uc2e0\ub3c4\ub294 \uc218\uc0c1\uc5d0\uac8c \uc545\ud55c \uc9c4\uc601\uc73c\ub85c \ubcf4\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]},{"id":"vortox","jinx":[{"id":"banshee","reason":"\ubcfc\ud1a1\uc2a4\uac00 \ubc34\uc2dc\ub97c \uc8fd\uc774\uba74, \ubaa8