 \ub808\ube44\uc544\ud0c4\uc740 \uc0b4\uc544 \uc788\ub294 \uc120\ud55c \ud50c\ub808\uc774\uc5b4 1\uba85(\uc774\uc804 \ubc24\uacfc \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4: \uc120\ud0dd\ub41c \ub18d\ubd80\ub294 \ub2a5\ub825\uc744 \uc4f0\uc9c0\ub9cc \uc8fd\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"mayor","reason":"\ub2e4\uc12f\uc9f8 \ub0a0\uc5d0 \ub808\ube44\uc544\ud0c4\uacfc \uc2dc\uc7a5\uc774 \uc0b4\uc544 \uc788\uace0 \ucc98\ud615\uc774 \uc77c\uc5b4\ub098\uc9c0 \uc54a\uc73c\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"exorcist","reason":"\ub808\ube44\uc544\ud0c4\uc774 \uad6c\ub9c8\uc0ac\uc81c\uac00 \uc120\ud0dd\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc9c0\ubaa9\ud574 \ucc98\ud615\ud558\uba74, \uc120\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"grandmother","reason":"\ub808\ube44\uc544\ud0c4\uc774 \ucc38\uc5ec\ud558\ub294\ub370 \uc190\uc8fc\uac00 \ucc98\ud615\uc73c\ub85c \uc8fd\uc73c\uba74, \uc545\ud55c \ud300\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4."},{"id":"king","reason":"\ub808\ube44\uc544\ud0c4\uc774 \ucc38\uc5ec\ud558\uace0 \uc801\uc5b4\ub3c4 1\uba85\uc774 \uc8fd\uc5c8\ub2e4\uba74, \uc655\uc740 \ub9e4\uc77c \ubc24 \uc0b4\uc544 \uc788\ub294 \uce90\ub9ad\ud130 1\uac1c\ub97c \uc54c\uac8c \ub429\ub2c8\ub2e4."},{"id":"hatter","reason":"\ub808\ube44\uc544\ud0c4\uc740 \ub2e4\uc12f\uc9f8 \ub0a0 \uc774\ud6c4\uc5d0\ub294 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"pithag","reason":"\ub808\ube44\uc544\ud0c4\uc740 \ub2e4\uc12f\uc9f8 \ub0a0 \uc774\ud6c4\uc5d0\ub294 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"lilmonsta","jinx":[{"id":"poppygrower","reason":"\ub9b4 \ubaac\uc2a4\ud0c0\uc640 \uc591\uadc0\ube44 \uc7ac\ubc30\uafbc\uc774 \uc0b4\uc544 \uc788\ub2e4\uba74, \ud558\uc218\uc778 \uc911 1\uba85\uc774 \ub9b4 \ubaac\uc2a4\ud0c0 \ud1a0\ud070\uc744 \uac00\uc838\uac00\uae30\ub85c \ud560 \ub54c\uae4c\uc9c0 \ud558\uc218\uc778\u