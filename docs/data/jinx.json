\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \ucc38\uac00 \uc911\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"baron","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \ucc38\uac00 \uc911\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"pithag","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \ucc38\uac00 \uc911\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"spy","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \ucc38\uac00 \uc911\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"widow","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \ucc38\uac00 \uc911\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"lleech","reason":"\ub450 \uce90\ub9ad\ud130\uac00 \ub3d9\uc2dc\uc5d0 \ucc38\uac00 \uc911\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},{"id":"boffin","reason":"The Demon cannot have the Heretic ability."}]},{"id":"bountyhunter","jinx":[{"id":"philosopher","reason":"\ucca0\ud559\uc790\uac00 \ud604\uc0c1\uae08 \uc0ac\ub0e5\uafbc\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc120\ud55c \uc8fc\ubbfc\uc740 1\uba85\uc740 \uc545\ud55c \uc9c4\uc601\uc73c\ub85c \ubcc0\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"id":"kazali","reason":"\uce74\uc798\ub9ac\uac00 \ud604\uc0c1\uae08 \uc0ac\ub0e5\uafbc\uc744 \ud558\uc218\uc778\uc73c\ub85c \ub9cc\ub4e4\uc5c8\ub2e4\uba74 \uc545\ud55c \uc8fc\ubbfc\uc740 \ub9cc\ub4e4\uc5b4\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"alhadikhia","jinx":[{"id":"princess","reason":"\uacf5\uc8fc\uac00 \uccab \ub0a0 \ub204\uad70\uac00\ub97c \uc9c0\uba85\ud574\uc11c \ucc98\ud615\ud55c \uacbd\uc6b0, \uadf8 \ubc24\uc5d0 \uc54c\ud558\ub514\ud0a4\uc544\uc5d0\uac8c \uc544\ubb34\ub3c4 \uc8fd\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}]},{"id":"alchemist","jinx":[{"id":"wraith","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \ub808\uc774\uc2a4\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \ub2a5\ub825\uc774 \uc5c6\uace0, \ub808\uc774\uc2a4\uac00 \uac8c\uc784\uc5d0 \ucc38\uac00\ud569\ub2c8\ub2e4. \ub9e4\uc77c \ucc98\ud615 \ub2e8\uacc4 \ud6c4, \uc0b4\uc544\uc788\ub294 \uc5f0\uae08\uc220\uc0ac\ub294 \ub808\uc774\uc2a4\ub97c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ub808\uc774\uc2a4\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"spy","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \ucca9\uc790\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \ub2a5\ub825\uc774 \uc5c6\uace0, \ucca9\uc790\uac00 \uac8c\uc784\uc5d0 \ucc38\uac00\ud569\ub2c8\ub2e4. \ub9e4\uc77c \ucc98\ud615 \ub2e8\uacc4 \ud6c4, \uc0b4\uc544\uc788\ub294 \uc5f0\uae08\uc220\uc0ac\ub294 \ucca9\uc790\ub97c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \ucca9\uc790\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"widow","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uacfc\ubd80\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \ub2a5\ub825\uc774 \uc5c6\uace0, \uacfc\ubd80\uac00 \uac8c\uc784\uc5d0 \ucc38\uac00\ud569\ub2c8\ub2e4. \ub9e4\uc77c \ucc98\ud615 \ub2e8\uacc4 \ud6c4, \uc0b4\uc544\uc788\ub294 \uc5f0\uae08\uc220\uc0ac\ub294 \uacfc\ubd80\ub97c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \uacfc\ubd80\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."},{"id":"marionette","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uaf2d\ub450\uac01\uc2dc\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \ub2a5\ub825\uc774 \uc5c6\uace0, \uaf2d\ub450\uac01\uc2dc\uac00 \uac8c\uc784\uc5d0 \ucc38\uac00\ud569\ub2c8\ub2e4."},{"id":"summoner","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uc18c\ud658\uc0ac\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ucc38\uac00\ud558\uc9c0 \uc54a\ub294 \uce90\ub9ad\ud130 3\uac00\uc9c0\ub97c \uc54c \uc218 \uc5c6\uace0 \uc545\ub9c8 \uce90\ub9ad\ud130\ub9cc \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc545\ub9c8\ub97c \ub9cc\ub4e4\uae30 \uc804\uc5d0 \uc5f0\uae08\uc220\uc0ac\uac00 \uc8fd\uc744 \uacbd\uc6b0, \uc545\ud55c \uc9c4\uc601\uc774 \uc2b9\ub9ac\ud569\ub2c8\ub2e4. [\uc545\ub9c8 \uc5c6\uc74c]"},{"id":"mastermind","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \ubc30\ud6c4\uc778\ubb3c\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \ub2a5\ub825\uc774 \uc5c6\uace0, \ubc30\ud6c4\uc778\ubb3c\ub3c4 \uac8c\uc784\uc5d0 \ucc38\uac00\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{"id":"organgrinder","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \ud48d\uac01\uc7c1\uc774\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \ud48d\uac01\uc7c1\uc774\uac00 \uac8c\uc784\uc5d0 \ucc38\uac00\ud569\ub2c8\ub2e4. \uc5f0\uae08\uc220\uc0ac\uc640 \ud48d\uac01\uc7c1\uc774\uac00 \ubaa8\ub450 \ucde8\ud558\uc9c0 \uc54a\uc558\ub2e4\uba74 \ub458 \ub2e4 \ucde8\ud558\uac8c \ub429\ub2c8\ub2e4."},{"id":"boffin","reason":"\uc5f0\uae08\uc220\uc0ac\uac00 \uacfc\ud559\uc790\uc758 \ub2a5\ub825\uc744 \uc5bb\ub294\ub2e4\uba74, \uc5f0\uae08\uc220\uc0ac\ub294 \uc545\ub9c8\uac00 \uac00\uc9c0\uac8c \ub41c \uc8fc\ubbfc \ub2a5\ub825\uc744 \uc54c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}]},{"id":"magician","jinx":[{"id":"widow","reason":"\uacfc\ubd80\uac00 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \ub54c, \uc545\ub9c8\uc640 \ub9c8\uc220\uc0ac\uc758 \uce90\ub9ad\ud130 \ud1a0\ud070\uc740 \uc81c\uac70\ub429\ub2c8\ub2e4."},{"id":"spy","reason":"\ucca9\uc790\uac00 \ub9c8\ub3c4\uc11c\ub97c \ubcfc \ub54c, \uc545\ub9c8\uc640 \ub9c8\uc220\uc0ac\uc758 \uce90\ub9ad\ud130 \ud1a0\ud070\uc740 \uc81c\uac70\ub429\ub2c8\ub2e4."},{"id":"wraith","reason":"\ub9e4\uc77c \ucc98\ud615 \ub2e8\uacc4 \ud6c4, \uc0b4\uc544\uc788\ub294 \ub9c8\uc220\uc0ac\ub294 \ub808\uc774\uc2a4\ub97c \uacf5\uac1c\uc801\uc73c\ub85c \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ub2e4\uba74, \uc545\ub9c8\ub294 \uc624\ub298 \ubc24 \ub808\uc774\uc2a4\ub97c \uc1