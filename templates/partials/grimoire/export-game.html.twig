<button type="button" class="button button--full-height" id="export-game" data-dialog="#game-export">{{ 'grimoire.export.title'|trans }}</button>

{# 참가자용 마도서 링크 만들기 (assets/js/processes/grimoire/export.js) #}
{% embed 'includes/dialog.html.twig' with {
    id: 'game-export',
    background: 'blur',
    title: 'grimoire.export.title'|trans
} %}
    {% block body %}
    <p style="text-align: center; word-break: keep-all;">참가자용 마도서 링크를 만듭니다.<br>단톡방에 올리면 참가자들이 각자 폰에서 이 시트와 참가자 이름이 적힌 빈 접시로 메모할 수 있습니다.</p>
    <p class="mt-4" style="text-align: center; word-break: keep-all;">캐릭터와 알림 토큰은 링크에 담기지 않습니다.</p>
    <ul class="button-list mt-4" style="max-width: 20em; margin-inline: auto;">
        <li><button type="button" class="button" id="export-make">링크 만들기</button></li>
    </ul>
    <div class="mt-4" id="export-result" role="status" aria-live="polite" hidden></div>
    {% endblock %}
{% endembed %}
