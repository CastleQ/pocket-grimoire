<button type="button" class="button button--full-height" id="select-edition" data-dialog="#edition-list">{{ 'setup.buttons.select_edition'|trans }}</button>

{% embed 'includes/dialog.html.twig' with {
    id: 'edition-list',
    background: 'blur',
    title: 'setup.editions.title'|trans
} %}
    {% import 'macros/forms.html.twig' as forms %}
    {% block body %}

    <form id="select-edition-form" enctype="multipart/form-data">

        <details class="edition-group" open>
            <summary class="edition-group__summary">공식 시트</summary>
            <ul class="no-list edition-group__list js--edition-list" data-category="official">
                <li class="edition-group__empty">불러오는 중…</li>
            </ul>
        </details>

        <details class="edition-group">
            <summary class="edition-group__summary">인기 커스텀 시트</summary>
            <ul class="no-list edition-group__list js--edition-list" data-category="custom">
                <li class="edition-group__empty">불러오는 중…</li>
            </ul>
        </details>

        <details class="edition-group">
            <summary class="edition-group__summary">인기 홈브류 시트</summary>
            <ul class="no-list edition-group__list js--edition-list" data-category="homebrew">
                <li class="edition-group__empty">불러오는 중…</li>
            </ul>
        </details>

        <details class="edition-group">
            <summary class="edition-group__summary">인기 틴시빌 시트</summary>
            <ul class="no-list edition-group__list js--edition-list" data-category="teensyville">
                <li class="edition-group__empty">불러오는 중…</li>
            </ul>
        </details>

        <details class="edition-group" id="edition-direct">
            <summary class="edition-group__summary">직접 입력 (파일·URL·붙여넣기)</summary>
            <!-- 직접 입력은 선택지가 하나뿐이라 라디오 단계를 생략한다.
                 드롭다운을 열면 아래 입력 영역이 바로 보이고, 숨김 라디오로 제출 시 custom을 식별한다. -->
            <input type="radio" name="edition" value="custom" id="edition-custom" hidden>
            <div id="custom-script" class="mb-4">
            <p>{{ 'setup.editions.custom_note'|trans }} <strong>{{ 'setup.editions.custom_warning'|trans }}</strong></p>
            <p>
                <label for="custom-script-upload">{{ 'setup.editions.upload'|trans }}</label>
                {{ forms.file({
                    name: "custom-script-upload",
                    id: "custom-script-upload",
                    accept: "application/json"
                }) }}
            </p>
            <p>
                <label for="custom-script-url">{{ 'setup.editions.url'|trans }}</label>
                <input type="url" name="custom-script-url" id="custom-script-url" class="input" placeholder="https://www.example.com/script.json" data-no-store>
            </p>
            <p>
                <label for="custom-script-paste">{{ 'setup.editions.paste'|trans }}</label>
                <textarea name="custom-script-paste" id="custom-script-paste" class="input" placeholder='["washerwoman","investigator","librarian","chef"]'></textarea>
            </p>
            </div>
        </details>

        <p>
            <button type="submit" class="button">
                <span class="button__text">{{ 'setup.editions.select'|trans }}</span>
                <span class="button__loader" role="progressbar" aria-valuetext="Loading" aria-busy="false" aria-live="assertive" aria-valuemin="0" aria-valuemax="1">
                    <span class="loader" aria-hidden="true"></span>
                </span>
            </button>
        </p>

    </form>
    {% endblock %}
{% endembed %}
