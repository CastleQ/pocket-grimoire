<button type="button" class="button button--full-height" id="qr-code-button" data-dialog="#qr-code-dialog" disabled>{{ 'setup.buttons.qr_code_button'|trans }}</button>

{% embed 'includes/dialog.html.twig' with {
    id: 'qr-code-dialog',
    background: 'hide',
    title: 'setup.qr_code.title'|trans
} %}
    {% import 'macros/forms.html.twig' as forms %}
    {% block body %}
        <p>{{ 'setup.qr_code.intro'|trans }}</p>
        <button type="button" class="button" id="open-sheet" disabled>
            <span class="button__text">{{ 'setup.qr_code.open'|trans }}</span>
            <span class="button__loader" aria-hidden="true"></span>
        </button>

        <button type="button" class="button mt-4" id="share-sheet" disabled>
            <span class="button__text">{{ 'setup.qr_code.share'|trans }}</span>
            <span class="button__loader" aria-hidden="true"></span>
        </button>
        <div class="mt-4" id="share-sheet-result" hidden></div>

        <p class="mt-4" id="include-groups">{{ 'setup.qr_code.include'|trans }}</p>
        <div class="slot slot--2">
            {{ forms.switch({
                node: 'div',
                label: 'setup.qr_code.travellers'|trans,
                name: 'include-travellers',
                id: 'include-travellers',
                checked: false,
                attributes: {
                    'aria-describedby': 'include-groups'
                }
            }) }}
            {{ forms.switch({
                node: 'div',
                label: 'setup.qr_code.fabled'|trans,
                name: 'include-fabled',
                id: 'include-fabled',
                checked: true,
                attributes: {
                    'aria-describedby': 'include-groups'
                }
            }) }}
        </div>
    {% endblock %}
{% endembed %}