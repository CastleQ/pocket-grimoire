{% extends "base.html.twig" %}

{% block title %}{{ 'index.title'|trans }}{% endblock %}
{% set meta_description = 'index.description'|trans %}

{% block styles %}{{ encore_entry_link_tags('css/main') }}{% endblock %}

{% set body_class = 'body-grimoire' %}

{% block body %}

<div class="title-bar">
    <h1 class="title">{{ 'title'|trans }}</h1>
    <a href="coffee.html" class="coffee-link">
        <img src="/build/img/talk.png" alt="오픈카톡 문의" width="80" height="80" class="coffee-link__icon">
        <span class="coffee-link__text">커피 사주기</span>
    </a>
</div>

{# 참가자용 마도서(?play=…)에서만 보임 — assets/js/utils/play-mode.js, processes/play-mode.js #}
<div class="play-mode-banner">
    <p><strong>참가자용 마도서</strong></p>
    <p id="play-mode-status" role="status" aria-live="polite" hidden></p>
</div>

{# 참가자용 마도서를 앱 안 브라우저(카카오톡 등)로 열면 시작할 때 띄운다 — processes/play-mode.js #}
{% embed 'includes/dialog.html.twig' with {
    id: 'play-inapp',
    background: 'blur',
    title: '※ 외부 브라우저로 접속을 권장합니다! ※'
} %}
    {% block body %}
    <p style="text-align: center; word-break: keep-all;">카카오톡 브라우저는 창을 나갔다 오면 기록이 지워질 수 있습니다.<br>게임내내 기록해둔 메모가 지워지면 마음이 아픕니다🥲</p>
    <img src="img/notice/play-open-external.webp" alt="오른쪽 아래 ⋮ 메뉴의 [다른 브라우저로 열기]" width="666" height="720" class="mt-4" style="display: block; width: 100%; height: auto; max-height: 40vh; object-fit: contain;">
    <ul class="button-list mt-4" style="--columns: 1; max-width: 16em; margin-inline: auto;">
        <li id="play-inapp-open-item"><button type="button" class="button" id="play-inapp-open">다른 브라우저로 열기</button></li>
        <li><button type="button" class="button" style="--bg-colour: var(--red);" data-dialog-hide>취소</button></li>
    </ul>
    {% endblock %}
{% endembed %}

{% include 'partials/setup.html.twig' %}
{% include 'partials/grimoire.html.twig' %}
{% include 'partials/jinxes.html.twig' %}
{% include 'partials/night-order.html.twig' %}
{% include 'partials/info-tokens.html.twig' %}
{% include 'partials/notes.html.twig' %}
{% include 'partials/acknowledgements.html.twig' %}
{% include 'partials/community.html.twig' %}

{% endblock %}

{% block javascript %}
{% set version = hash(4) %}
<script>
var URLS = {
    characters: "{{ path('data_characters', { version: version })|e('js') }}",
    jinxes: "{{ path('data_jinx', { version: version })|e('js') }}",
    game: "{{ path('data_game')|e('js') }}",
    homebrew: "{{ path('homebrew')|e('js') }}",
    url: "{{ path('data_url', { url: '{url}' })|e('js') }}",
    scriptsBase: "/scripts/"
};

var I18N = {
    goodTeam: "{{ 'messages.good_team'|trans|e('js') }}",
    evilTeam: "{{ 'messages.evil_team'|trans|e('js') }}",
    emptyCharacterAbility: "{{ 'messages.empty_character_ability'|trans|e('js') }}",
    versionChange: "{{ 'messages.version_change_message'|trans|e('js') }}",
    invalidScript: "{{ 'messages.invalid_script'|trans|e('js') }}",
    noCharacters: "{{ 'messages.no_characters'|trans|e('js') }}",
    customInfoToken: "{{ 'messages.custom_info_token'|trans|e('js') }}",
    bagDisabled: "{{ 'messages.bag_disabled'|trans|e('js') }}",
};

var ENVIRONMENT = "{{ app.environment|e('js') }}";
</script>
{{ encore_entry_script_tags('js/main') }}
{% endblock %}
