<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="copyright" content="{{ meta_copyright|default('Skateside') }}">
<meta name="robots" content="{{ meta_robots|default(app.environment == 'prod' ? 'index,follow' : 'noindex,nofollow') }}">
<meta name="author" content="{{ meta_author|default('Skateside') }}">
<meta name="revisit-after" content="{{ meta_revisit|default('30 days') }}">
<meta name="description" content="{{ meta_description|default('') }}">

{# Open Graph / 링크 공유 미리보기 (제목·사이트명) #}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ 'share_title'|trans }}">
<meta property="og:site_name" content="{{ 'share_title'|trans }}">
<meta property="og:description" content="{{ meta_description|default('') }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ 'share_title'|trans }}">
<meta name="twitter:description" content="{{ meta_description|default('') }}">
